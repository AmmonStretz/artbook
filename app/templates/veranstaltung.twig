{% extends 'base.twig' %}

{% block head_extra %}
  {% if has_map %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  {% endif %}
{% endblock %}

{% block content %}
  {% set show_back_link = true %}
  {% set form_vid = vid %}
  {% set pagination_base = '?id=' ~ vid ~ (q ? '&q=' ~ q|url_encode : '') %}
  {% include 'partials/event-detail-content.twig' %}
{% endblock %}

{% block scripts %}
  {% include 'partials/event-map-script.twig' with {'show_popup': true} %}
{% endblock %}
