{% extends 'base.twig' %}

{% block head_extra %}
  {% if has_map %}
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" crossorigin="">
  {% endif %}
{% endblock %}

{% block content %}
  {% set event_name = (lang == 'en' and event.name_en) ? event.name_en : event.name %}
  <section class="detail-header{{ titelbild_url ? ' detail-header--with-image' : '' }}">
    {% if titelbild_url %}
      <img src="{{ titelbild_url }}" alt="" class="detail-header-img">
      <div class="detail-header-overlay"></div>
    {% endif %}
    <div class="container">
      <a href="{{ langUrl('/') }}" class="detail-back">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <polyline points="15 18 9 12 15 6"/>
        </svg>
        {{ t('event.back_home') }}
      </a>
      <div class="detail-type-badge">{{ t('event.badge') }}</div>
      <h1 class="detail-title">{{ event_name }}</h1>
      {% if in_bewerbung %}
        <a href="{{ langUrl('/kontakt.php') }}" class="pub-btn detail-header-bew-btn" style="margin-top:.875rem;width:fit-content">
          <i class="fa-solid fa-file-signature"></i>
          {{ t('event.apply_now') }}
        </a>
      {% endif %}
      {% if event.erster_tag or event.ort_name or event.ort %}
        <div class="event-header-meta">
          {% if event.erster_tag %}
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/>
                <line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/>
              </svg>
              {{ fmt(event.erster_tag) }}{{ event.letzter_tag != event.erster_tag ? ' – ' ~ fmt(event.letzter_tag) : '' }}
            </span>
          {% endif %}
          {% if event.ort_name or event.ort %}
            <span>
              <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0118 0z"/><circle cx="12" cy="10" r="3"/>
              </svg>
              {{ event.ort_name ?: ((event.plz ~ ' ' ~ event.ort)|trim) }}
            </span>
          {% endif %}
        </div>
      {% endif %}
    </div>
  </section>

  <section class="section" style="padding-top:2.5rem;padding-bottom:2.5rem;border-bottom:1px solid var(--border)">
    <div class="container">
      <div class="event-detail-grid">
        <div>
          {% set beschr = (lang == 'en' and event.beschreibung_en) ? event.beschreibung_en : event.beschreibung %}
          {% if beschr %}
            <div class="detail-description" style="margin-bottom:2rem">{{ beschr|raw }}</div>
          {% endif %}
          {% if has_addr %}
            <div class="event-address-block">
              <div class="section-label" style="margin-bottom:.625rem">{{ t('event.address') }}</div>
              {% if event.ort_name %}<div class="event-address-name">{{ event.ort_name }}</div>{% endif %}
              {% if event.strasse %}<div>{{ event.strasse }}</div>{% endif %}
              {% if event.plz or event.ort %}<div>{{ (event.plz ~ ' ' ~ event.ort)|trim }}</div>{% endif %}
              <div style="display:flex;gap:.625rem;flex-wrap:wrap;margin-top:1rem">
                {% if event.ort_url %}
                  <a href="{{ event.ort_url }}" target="_blank" rel="noopener"
                     class="pub-btn pub-btn-ghost" style="font-size:.8125rem;padding:.4rem .875rem">
                    <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                      <path d="M18 13v6a2 2 0 01-2 2H5a2 2 0 01-2-2V8a2 2 0 012-2h6"/>
                      <polyline points="15 3 21 3 21 9"/><line x1="10" y1="14" x2="21" y2="3"/>
                    </svg>
                    {{ t('event.website') }}
                  </a>
                {% endif %}
                <a href="https://www.google.com/maps/search/?api=1&query={{ gmaps_query }}"
                   target="_blank" rel="noopener"
                   class="pub-btn pub-btn-ghost" style="font-size:.8125rem;padding:.4rem .875rem">
                  <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <polygon points="3 11 22 2 13 21 11 13 3 11"/>
                  </svg>
                  {{ t('event.directions') }}
                </a>
              </div>
            </div>
          {% endif %}
        </div>

        <div>
          {% if days %}
            <div class="section-label" style="margin-bottom:.625rem">{{ t('event.opening_hours') }}</div>
            <div class="event-days-list">
              {% for d in days %}
                <div class="event-day-row">
                  <div>
                    <div class="event-day-weekday">{{ fmtWeekday(d.datum) }}</div>
                    <div class="event-day-date">{{ fmt(d.datum) }}</div>
                  </div>
                  <div class="event-day-time">{{ fmtTime(d.startzeit) }} – {{ fmtTime(d.endzeit) }}{% if lang == 'de' %} Uhr{% endif %}</div>
                </div>
              {% endfor %}
            </div>
          {% endif %}
          {% if has_map %}
            <div class="section-label" style="margin-top:{{ days ? '2rem' : '0' }};margin-bottom:.625rem">{{ t('event.map') }}</div>
            <div id="event-map" class="event-map-wrap"></div>
          {% endif %}
        </div>
      </div>
    </div>
  </section>

  {% if program_by_day %}
    <section class="section" style="padding-top:2.5rem;padding-bottom:2.5rem;border-bottom:1px solid var(--border)">
      <div class="container">
        <div class="prog-preview-header" style="margin-bottom:1.25rem">
          <div class="section-label">{{ t('event.program') }}</div>
          <a href="{{ langUrl('/programm.php') }}?id={{ vid }}" class="pub-btn pub-btn-ghost prog-preview-link">
            {{ total_prog }} {{ total_prog == 1 ? t('event.program_item_sg') : t('event.program_item_pl') }} →
          </a>
        </div>
        {% for e in preview3 %}
          {% set e_titel = (lang == 'en' and e.titel_en) ? e.titel_en : e.titel %}
          <div class="program-entry">
            <div class="program-time">{{ e.uhrzeit|slice(0,5) }}{% if lang == 'de' %} Uhr{% endif %}</div>
            <div>
              <div class="program-title">{{ e_titel|raw }}</div>
              {% if e.ort_name %}
                <div class="program-location">{{ e.ort_name }}</div>
              {% endif %}
            </div>
          </div>
        {% endfor %}
        {% if total_prog > 3 %}
          <div style="margin-top:1rem">
            <a href="{{ langUrl('/programm.php') }}?id={{ vid }}" class="pub-btn pub-btn-outline" style="font-size:.875rem">
              {{ t('event.view_full_program') }}
            </a>
          </div>
        {% endif %}
      </div>
    </section>
  {% endif %}

  {% if event.teilnehmer_sichtbar %}
    <section class="section" style="padding-top:2rem">
      <div class="container">
        <h2 class="event-section-heading">
          {% if q %}
            {{ total }} {{ total == 1 ? t('event.result_sg') : t('event.result_pl') }} für «{{ q }}»
          {% else %}
            {{ total }} {{ t('event.participants') }}
          {% endif %}
        </h2>

        <form method="get" class="pub-search">
          <input type="hidden" name="id" value="{{ vid }}">
          <input type="search" name="q" value="{{ q }}"
                 class="pub-search-input" placeholder="{{ t('event.search_participants') }}" autocomplete="off">
          <button type="submit" class="pub-btn pub-btn-ghost">{{ t('event.search_btn') }}</button>
          {% if q %}
            <a href="?id={{ vid }}" class="pub-btn pub-btn-ghost">{{ t('event.reset') }}</a>
          {% endif %}
        </form>

        {% if total == 0 %}
          <p class="text-muted">{{ q ? t('event.no_results') : t('event.no_participants') }}</p>
        {% else %}
          <div class="participant-grid">
            {% for p in participants %}
              {% set thumb = thumbUrl(p.first_image) %}
              {% set type_label = typeLabel(p.typ, p.gruppe_typ) %}
              <a href="{{ langUrl('/teilnehmer.php') }}?id={{ p.id }}&vid={{ vid }}" class="participant-card">
                {% if thumb %}
                  <img src="{{ thumb }}" alt="{{ p.name }}" class="participant-thumb" loading="lazy">
                {% else %}
                  <div class="participant-thumb-placeholder">
                    <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                      <rect x="3" y="3" width="18" height="18" rx="2"/>
                      <circle cx="8.5" cy="8.5" r="1.5"/>
                      <polyline points="21 15 16 10 5 21"/>
                    </svg>
                  </div>
                {% endif %}
                <div class="participant-info">
                  <div class="participant-name">{{ p.name }}</div>
                  <div class="participant-type">{{ type_label }}</div>
                  {% if p.tischnummer %}
                    <div class="participant-stand">{{ t('event.stand') }} {{ p.tischnummer }}</div>
                  {% endif %}
                </div>
              </a>
            {% endfor %}
          </div>

          {% include 'partials/pagination.twig' with {
            page: page, pages: pages,
            pagination_base: '?id=' ~ vid ~ (q ? '&q=' ~ q|url_encode : '')
          } %}
        {% endif %}
      </div>
    </section>
  {% endif %}
{% endblock %}

{% block scripts %}
  {% if has_map %}
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" crossorigin=""></script>
    <script>
    (function () {
      var map = L.map('event-map', { scrollWheelZoom: false }).setView([{{ event.lat }}, {{ event.lng }}], 15);
      L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
        attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
        maxZoom: 19
      }).addTo(map);
      L.marker([{{ event.lat }}, {{ event.lng }}])
        .addTo(map)
        .bindPopup('<strong>{{ event.ort_name ?: event_name }}</strong>', { closeButton: false })
        .openPopup();
    })();
    </script>
  {% endif %}
{% endblock %}
