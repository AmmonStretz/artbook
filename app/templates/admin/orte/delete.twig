{% extends 'base.twig' %}

{% block content %}
<div class="card" style="max-width:480px">
  <div class="card-header">
    <span class="card-title">{{ page_title }}</span>
    <a href="/admin/orte/" class="btn btn-ghost btn-sm">← Zurück</a>
  </div>
  <div class="card-body">
    <p>Soll <strong>«{{ name }}»</strong> wirklich gelöscht werden?</p>
    {% if veranstaltungen_count > 0 %}
      <p style="color:var(--text-muted);font-size:.875rem">
        {{ veranstaltungen_count }} Veranstaltung{{ veranstaltungen_count != 1 ? 'en' : '' }}
        {{ veranstaltungen_count != 1 ? 'verweisen' : 'verweist' }} auf diesen Ort.
        Die Adressdaten der Veranstaltungen bleiben erhalten.
      </p>
    {% endif %}
    <form method="post" style="margin-top:1.25rem;display:flex;gap:.5rem">
      <button type="submit" name="confirm" value="yes" class="btn btn-danger">Ja, löschen</button>
      <a href="/admin/orte/" class="btn btn-secondary">Abbrechen</a>
    </form>
  </div>
</div>
{% endblock %}
