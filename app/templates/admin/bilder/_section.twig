{% set ns = 'bs_' ~ bild_tid %}
{% set cnt = bilder|length %}
<div class="card" style="margin-top:1.25rem;max-width:var(--bild-max-width,860px)">
  <div class="card-header">
    <span class="card-title">
      Bilder
      <span id="{{ ns }}_count" style="color:var(--text-muted);font-weight:400;font-size:.875rem">
        &nbsp;{{ cnt }}
      </span>
    </span>
    <label id="{{ ns }}_label" class="btn btn-primary btn-sm" style="cursor:pointer">
      <i class="fa-solid fa-upload"></i>
      Bilder hochladen
      <input type="file" id="{{ ns }}_input" accept=".jpg,.jpeg,.png,.webp" multiple hidden>
    </label>
  </div>
  <div class="card-body">
    <p class="bild-hint">
      Mindestens {{ IMG_MIN_WIDTH }} px Breite &nbsp;·&nbsp;
      wird auf {{ IMG_MAX_WIDTH }}px / 768px skaliert &nbsp;·&nbsp;
      JPEG, PNG, WebP
    </p>
    <div id="{{ ns }}_errors"></div>
    <div id="{{ ns }}_grid" class="bild-grid">
      {% for b in bilder %}
        {% set url   = thumbUrl(b.dateiname) %}
        {% set titel    = b.titel|default('') %}
        {% set titel_en = b.titel_en|default('') %}
        {% set alt      = b.alt_text|default('') %}
        {% set alt_en   = b.alt_text_en|default('') %}
        {% set datum    = b.startdatum|default('') %}
        <div class="bild-card" data-id="{{ b.id }}">
          <div class="bild-thumb-wrap" onclick="bildPreview('{{ url|escape('js') }}',{{ b.id }},'{{ titel|escape('js') }}')">
            <img class="bild-thumb" src="{{ url }}" alt="{{ alt }}" loading="lazy">
            <span class="bild-id">#{{ b.id }}</span>
          </div>
          <div class="bild-meta">
            <input type="text" class="bild-titel"    placeholder="Titel (DE)" value="{{ titel }}">
            <input type="text" class="bild-titel-en" placeholder="Titel (EN)" value="{{ titel_en }}">
            <input type="text" class="bild-alt"      placeholder="Alternativtext (DE)" value="{{ alt }}">
            <input type="text" class="bild-alt-en"   placeholder="Alt text (EN)" value="{{ alt_en }}">
            <input type="date" class="bild-datum" title="Startdatum" value="{{ datum }}">
          </div>
          <div class="bild-actions">
            <button type="button" class="btn btn-secondary btn-sm" style="flex:1"
                    onclick="bildSave(this,{{ b.id }})">Speichern</button>
            <button type="button" class="btn btn-ghost btn-sm"
                    onclick="bildReassignOpen({{ b.id }})" title="Anderem Teilnehmer zuweisen">
              <i class="fa-solid fa-arrow-right-arrow-left" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-ghost btn-sm"
                    onclick="bildUnassign(this,{{ b.id }})" title="Zuordnung aufheben">
              <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
            </button>
            <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger)"
                    onclick="bildDelete(this,{{ b.id }})" title="Löschen">
              <i class="fa-solid fa-trash" aria-hidden="true"></i>
            </button>
          </div>
        </div>
      {% else %}
        <p class="bild-empty" id="{{ ns }}_empty">Noch keine Bilder hochgeladen.</p>
      {% endfor %}
    </div>
  </div>
</div>

<dialog id="bild-reassign-dialog" class="tn-dialog">
  <div class="tn-dialog-header">
    <span class="tn-dialog-title">Bild zuweisen</span>
    <button type="button" class="btn btn-ghost btn-sm"
            onclick="document.getElementById('bild-reassign-dialog').close()">✕</button>
  </div>
  <div class="tn-dialog-body" style="padding:1.25rem;display:flex;flex-direction:column;gap:.75rem;min-width:320px">
    <input type="search" id="bild-reassign-search" placeholder="Teilnehmer suchen …"
           class="search-input" autocomplete="off">
    <select id="bild-reassign-select" class="member-add-select" size="8"
            style="height:auto;min-height:180px">
      <option value="">Laden …</option>
    </select>
    <p id="bild-reassign-error" style="color:var(--danger);font-size:.8125rem;display:none"></p>
  </div>
  <div class="tn-dialog-footer">
    <button type="button" class="btn btn-ghost btn-sm"
            onclick="document.getElementById('bild-reassign-dialog').close()">Abbrechen</button>
    <button type="button" class="btn btn-primary btn-sm" id="bild-reassign-confirm">Zuweisen</button>
  </div>
</dialog>

<dialog id="bild-preview-dialog" class="bild-preview-dialog">
  <div class="bild-preview-header">
    <span id="bild-preview-label" style="font-size:.8125rem"></span>
    <button type="button" class="btn btn-ghost btn-sm" style="color:#e2e8f0"
            onclick="document.getElementById('bild-preview-dialog').close()">✕</button>
  </div>
  <img id="bild-preview-img" src="" alt="" style="display:block;max-width:88vw;max-height:80vh;object-fit:contain">
</dialog>

<script>
document.getElementById('bild-preview-dialog').addEventListener('click', function(e) {
  if (e.target === this) this.close();
});
function bildPreview(url, id, titel) {
  document.getElementById('bild-preview-img').src = url;
  document.getElementById('bild-preview-label').textContent = (titel || '') + (titel ? ' · ' : '') + '#' + id;
  document.getElementById('bild-preview-dialog').showModal();
}
async function bildSave(btn, id) {
  const card    = btn.closest('.bild-card');
  const fd      = new FormData();
  fd.append('bild_id',     id);
  fd.append('titel',       card.querySelector('.bild-titel').value.trim());
  fd.append('titel_en',    card.querySelector('.bild-titel-en').value.trim());
  fd.append('alt_text',    card.querySelector('.bild-alt').value.trim());
  fd.append('alt_text_en', card.querySelector('.bild-alt-en').value.trim());
  const datumEl = card.querySelector('.bild-datum');
  if (datumEl) fd.append('startdatum', datumEl.value);
  btn.disabled = true; btn.textContent = '…';
  try {
    const r = await fetch('/admin/bilder/update.php', { method: 'POST', body: fd });
    const d = await r.json();
    btn.textContent = d.ok ? '✓ Gespeichert' : 'Fehler';
    setTimeout(() => { btn.disabled = false; btn.textContent = 'Speichern'; }, 1800);
  } catch { btn.disabled = false; btn.textContent = 'Speichern'; }
}
(function() {
  const dialog    = document.getElementById('bild-reassign-dialog');
  const search    = document.getElementById('bild-reassign-search');
  const select    = document.getElementById('bild-reassign-select');
  const confirmBtn = document.getElementById('bild-reassign-confirm');
  const errEl     = document.getElementById('bild-reassign-error');
  let currentBildId = null;
  let allOptions = [];

  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });

  let loaded = false;
  async function loadTeilnehmer() {
    if (loaded) return;
    const data = await (await fetch('/admin/teilnehmer/list_json.php')).json();
    select.innerHTML = '';
    allOptions = data.map(t => {
      const opt = document.createElement('option');
      opt.value = t.id;
      opt.textContent = t.name + ' (' + (t.kategorie || '–') + ')';
      opt.dataset.search = (t.name + ' ' + t.kategorie).toLowerCase();
      select.appendChild(opt);
      return opt;
    });
    loaded = true;
  }

  search.addEventListener('input', () => {
    const term = search.value.toLowerCase();
    allOptions.forEach(o => { o.hidden = term ? !o.dataset.search.includes(term) : false; });
    if (select.selectedOptions[0]?.hidden) select.value = '';
  });

  window.bildReassignOpen = async function(bildId) {
    currentBildId = bildId;
    errEl.style.display = 'none';
    search.value = '';
    await loadTeilnehmer();
    allOptions.forEach(o => { o.hidden = false; });
    select.value = '';
    dialog.showModal();
    search.focus();
  };

  confirmBtn.addEventListener('click', async () => {
    const targetId = parseInt(select.value);
    if (!targetId) { errEl.textContent = 'Bitte einen Teilnehmer auswählen.'; errEl.style.display = ''; return; }
    confirmBtn.disabled = true;
    const fd = new FormData();
    fd.append('bild_id',   currentBildId);
    fd.append('target_id', targetId);
    try {
      const d = await (await fetch('/admin/bilder/reassign.php', { method: 'POST', body: fd })).json();
      if (!d.ok) { errEl.textContent = d.error || 'Fehler'; errEl.style.display = ''; confirmBtn.disabled = false; return; }
      dialog.close();
      const card = document.querySelector(`.bild-card[data-id="${currentBildId}"]`);
      if (card) {
        const grid = card.parentNode;
        card.style.transition = 'opacity .2s';
        card.style.opacity = '0';
        setTimeout(() => {
          card.remove();
          if (typeof updateBildCount === 'function') updateBildCount(-1);
          if (!grid.querySelector('.bild-card')) {
            const p = document.createElement('p');
            p.className = 'bild-empty'; p.textContent = 'Noch keine Bilder hochgeladen.';
            grid.appendChild(p);
          }
        }, 220);
      }
    } catch { errEl.textContent = 'Netzwerkfehler.'; errEl.style.display = ''; confirmBtn.disabled = false; }
    confirmBtn.disabled = false;
  });
})();

async function bildDelete(btn, id) {
  if (!confirm('Dieses Bild unwiderruflich löschen?')) return;
  btn.disabled = true;
  const fd = new FormData();
  fd.append('bild_id', id);
  try {
    const r = await fetch('/admin/bilder/delete.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) {
      const card = btn.closest('.bild-card');
      const grid = card.parentNode;
      card.style.transition = 'opacity .2s';
      card.style.opacity    = '0';
      setTimeout(() => {
        card.remove();
        updateBildCount(-1);
        if (!grid.querySelector('.bild-card')) {
          const p = document.createElement('p');
          p.className = 'bild-empty'; p.textContent = 'Noch keine Bilder hochgeladen.';
          grid.appendChild(p);
        }
      }, 220);
    } else { btn.disabled = false; }
  } catch { btn.disabled = false; }
}
async function bildUnassign(btn, id) {
  if (!confirm('Nur die Zuordnung zum Teilnehmer aufheben? Das Bild bleibt erhalten.')) return;
  btn.disabled = true;
  const fd = new FormData();
  fd.append('bild_id', id);
  try {
    const r = await fetch('/admin/bilder/unassign.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) {
      const card = btn.closest('.bild-card');
      const grid = card.parentNode;
      card.style.transition = 'opacity .2s';
      card.style.opacity = '0';
      setTimeout(() => {
        card.remove();
        if (typeof updateBildCount === 'function') updateBildCount(-1);
        if (!grid.querySelector('.bild-card')) {
          const p = document.createElement('p');
          p.className = 'bild-empty'; p.textContent = 'Noch keine Bilder hochgeladen.';
          grid.appendChild(p);
        }
      }, 220);
    } else { btn.disabled = false; }
  } catch { btn.disabled = false; }
}
</script>

<script>
(function() {
  const input   = document.getElementById('{{ ns }}_input');
  const label   = document.getElementById('{{ ns }}_label');
  const grid    = document.getElementById('{{ ns }}_grid');
  const errWrap = document.getElementById('{{ ns }}_errors');
  const cntEl   = document.getElementById('{{ ns }}_count');
  const tid     = {{ bild_tid }};
  let count = {{ cnt }};

  function syncCount() {
    cntEl.textContent = ' ' + count;
  }

  window.updateBildCount = function(delta) {
    count += delta;
    syncCount();
  };

  input.addEventListener('change', () => {
    Array.from(input.files).forEach(upload);
    input.value = '';
  });

  async function upload(file) {
    const fd = new FormData();
    fd.append('teilnehmer_id', tid);
    fd.append('bild', file);
    try {
      const r = await fetch('/admin/bilder/upload.php', { method: 'POST', body: fd });
      const d = await r.json();
      if (d.error) { addErr(file.name + ': ' + d.error); return; }
      appendCard(d);
      count++;
      syncCount();
      const empty = document.getElementById('{{ ns }}_empty');
      if (empty) empty.remove();
    } catch { addErr(file.name + ': Upload fehlgeschlagen'); }
  }

  function addErr(msg) {
    const p = document.createElement('p');
    p.className = 'bild-error';
    p.textContent = msg;
    errWrap.appendChild(p);
    setTimeout(() => p.remove(), 6000);
  }

  function appendCard(d) {
    const div = document.createElement('div');
    div.innerHTML = bildCardHtml(d.id, d.url, '', '', '');
    const card = div.firstElementChild;
    card.classList.add('bild-new');
    grid.appendChild(card);
  }
})();

function bildCardHtml(id, url, titel, alt, datum) {
  function e(s) { return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;'); }
  return `<div class="bild-card" data-id="${id}">
    <div class="bild-thumb-wrap" onclick="bildPreview('${e(url)}',${id},'${e(titel)}')">
      <img class="bild-thumb" src="${e(url)}" alt="${e(alt)}" loading="lazy">
      <span class="bild-id">#${id}</span>
    </div>
    <div class="bild-meta">
      <input type="text" class="bild-titel"    placeholder="Titel (DE)" value="${e(titel)}">
      <input type="text" class="bild-titel-en" placeholder="Titel (EN)" value="">
      <input type="text" class="bild-alt"      placeholder="Alternativtext (DE)" value="${e(alt)}">
      <input type="text" class="bild-alt-en"   placeholder="Alt text (EN)" value="">
      <input type="date" class="bild-datum" title="Startdatum" value="${e(datum)}">
    </div>
    <div class="bild-actions">
      <button type="button" class="btn btn-secondary btn-sm" style="flex:1" onclick="bildSave(this,${id})">Speichern</button>
      <button type="button" class="btn btn-ghost btn-sm" onclick="bildUnassign(this,${id})" title="Zuordnung aufheben">
        <i class="fa-solid fa-link-slash" aria-hidden="true"></i>
      </button>
      <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger)" onclick="bildDelete(this,${id})" title="Löschen">
        <i class="fa-solid fa-trash" aria-hidden="true"></i>
      </button>
    </div>
  </div>`;
}
</script>
