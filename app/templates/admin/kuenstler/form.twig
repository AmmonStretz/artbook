{% extends 'base.twig' %}

{% block head_extra %}
<link rel="stylesheet" href="/assets/tiptap/tiptap.css">
{% endblock %}

{% block content %}
{% if is_copy %}
  <div class="alert" style="max-width:680px;background:#f0f9ff;border:1px solid #bae6fd;color:#0c4a6e;padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1.25rem;font-size:.875rem">
    Kopie von: <strong>{{ fetched_name }}</strong>
  </div>
{% endif %}
{% if errors %}
  <div class="alert alert-error" style="max-width:680px">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
{% endif %}

<form method="post" id="main-form" style="max-width:680px" novalidate>
  <div class="card">
    <div class="card-header">
      <span class="card-title">{{ page_title }}</span>
      <a href="/admin/kuenstler/" class="btn btn-ghost btn-sm">← Zurück zur Liste</a>
    </div>
    <div class="card-body">

      <div class="form-grid">
        <div class="form-group span-2">
          <label for="name">Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" value="{{ v.name }}" required autofocus>
        </div>

        <div class="form-group span-2">
          <label for="link">Link <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
          <input type="text" id="link" name="link" value="{{ v.link }}" placeholder="https://…">
        </div>

        <div class="form-group span-2">
          <label>Beschreibung <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
          <div class="lang-tabs">
            <button type="button" class="lang-tab active" onclick="switchDescLang(this,'de')">DE</button>
            <button type="button" class="lang-tab" onclick="switchDescLang(this,'en')">EN</button>
          </div>
          <div class="lang-panel" id="desc-panel-de">
            <div id="quill-editor"></div>
            <input type="hidden" name="beschreibung" id="beschreibung-input" value="{{ v.beschreibung }}">
          </div>
          <div class="lang-panel" id="desc-panel-en" style="display:none">
            <div id="quill-editor-en"></div>
            <input type="hidden" name="beschreibung_en" id="beschreibung-en-input" value="{{ v.beschreibung_en|default('') }}">
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" class="btn btn-primary">
          {{ is_edit ? 'Änderungen speichern' : (is_copy ? 'Kopie erstellen' : 'Künstler erstellen') }}
        </button>
        <a href="/admin/kuenstler/" class="btn btn-secondary">Abbrechen</a>
      </div>

    </div>
  </div>
</form>

{% if is_edit %}
  {% include 'bilder/_section.twig' with {'bild_tid': id, 'bilder': bilder} %}

  <div class="card" style="margin-top:1.25rem;max-width:680px">
    <div class="card-header">
      <span class="card-title">Bearbeitungslink</span>
      <button type="button" class="btn btn-secondary btn-sm" id="token-open-btn">
        <i class="fa-solid fa-link"></i>
        Link verwalten
      </button>
    </div>
    <div class="card-body" style="color:var(--text-muted);font-size:.875rem">
      Generiert einen einmalig verwendbaren Link, über den der Künstler sein Profil selbst bearbeiten kann.
    </div>
  </div>

  <dialog id="token-dialog" class="tn-dialog">
  <div class="tn-dialog-header">
    <span class="tn-dialog-title">Bearbeitungslink</span>
    <button type="button" id="token-dialog-close" class="btn btn-ghost btn-sm">✕</button>
  </div>
  <div class="tn-dialog-body" style="padding:1.25rem;min-height:120px">
    <div id="token-status">
      <p style="color:var(--text-muted)">Laden …</p>
    </div>
    <div id="token-url-wrap" style="display:none;margin-top:1rem">
      <label style="font-size:.8125rem;font-weight:600;display:block;margin-bottom:.375rem">Link (einmalig verwendbar):</label>
      <div style="display:flex;gap:.5rem;align-items:center">
        <input type="text" id="token-url-input" readonly
               style="flex:1;font-size:.8125rem;background:var(--bg-muted,#f1f5f9);cursor:default">
        <button type="button" class="btn btn-secondary btn-sm" id="token-copy-btn">
          <i class="fa-regular fa-copy"></i> Kopieren
        </button>
      </div>
    </div>
  </div>
  <div class="tn-dialog-footer" style="justify-content:space-between;gap:.5rem">
    <button type="button" class="btn btn-ghost btn-sm" id="token-revoke-btn"
            style="color:var(--danger);display:none">Link widerrufen</button>
    <button type="button" class="btn btn-primary btn-sm" id="token-generate-btn">
      Neuen Link generieren
    </button>
  </div>
</dialog>
{% endif %}
{% endblock %}

{% block scripts %}
<script type="module">
import { mkEditor, edHTML } from '/assets/tiptap/init.js';

const edDE = mkEditor(document.getElementById('quill-editor'),    { placeholder: 'Beschreibung eingeben …', initialHTML: {{ v.beschreibung|default('')|json_encode|raw }} });
const edEN = mkEditor(document.getElementById('quill-editor-en'), { placeholder: 'Description …',           initialHTML: {{ v.beschreibung_en|default('')|json_encode|raw }} });

window.switchDescLang = function(btn, lang) {
  btn.closest('.lang-tabs').querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('desc-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('desc-panel-en').style.display = lang === 'en' ? '' : 'none';
};

document.getElementById('main-form').addEventListener('submit', () => {
  document.getElementById('beschreibung-input').value    = edHTML(edDE);
  document.getElementById('beschreibung-en-input').value = edHTML(edEN);
});
</script>

{% if is_edit %}
<script>
(function() {
  const tid       = {{ id }};
  const dialog    = document.getElementById('token-dialog');
  const statusEl  = document.getElementById('token-status');
  const urlWrap   = document.getElementById('token-url-wrap');
  const urlInput  = document.getElementById('token-url-input');
  const copyBtn   = document.getElementById('token-copy-btn');
  const revokeBtn = document.getElementById('token-revoke-btn');
  const genBtn    = document.getElementById('token-generate-btn');

  document.getElementById('token-open-btn').addEventListener('click', () => {
    dialog.showModal();
    loadStatus();
  });
  document.getElementById('token-dialog-close').addEventListener('click', () => dialog.close());
  dialog.addEventListener('click', e => { if (e.target === dialog) dialog.close(); });

  async function loadStatus() {
    statusEl.innerHTML = '<p style="color:var(--text-muted)">Laden …</p>';
    urlWrap.style.display   = 'none';
    revokeBtn.style.display = 'none';
    try {
      const r = await fetch(`/admin/teilnehmer_token_ajax.php?id=${tid}`);
      const d = await r.json();
      if (!d.ok) return;
      if (!d.has_token) {
        statusEl.innerHTML = '<p style="color:var(--text-muted);font-size:.875rem">Kein aktiver Link vorhanden.</p>';
      } else if (d.used) {
        statusEl.innerHTML = '<p style="font-size:.875rem"><span style="color:var(--danger)">●</span> Link wurde bereits verwendet.</p>';
        revokeBtn.style.display = '';
      } else {
        statusEl.innerHTML = '<p style="font-size:.875rem"><span style="color:var(--success,#16a34a)">●</span> Aktiver Link vorhanden.</p>';
        revokeBtn.style.display = '';
      }
    } catch {
      statusEl.innerHTML = '<p style="color:var(--danger);font-size:.875rem">Fehler beim Laden.</p>';
    }
  }

  genBtn.addEventListener('click', async () => {
    genBtn.disabled = true; genBtn.textContent = 'Generieren …';
    const fd = new FormData();
    fd.append('action', 'generate');
    fd.append('id', tid);
    try {
      const r = await fetch('/admin/teilnehmer_token_ajax.php', { method: 'POST', body: fd });
      const d = await r.json();
      if (d.ok) {
        statusEl.innerHTML = '<p style="font-size:.875rem"><span style="color:var(--success,#16a34a)">●</span> Neuer Link generiert.</p>';
        urlInput.value          = d.url;
        urlWrap.style.display   = '';
        revokeBtn.style.display = '';
      }
    } catch {}
    genBtn.disabled = false; genBtn.textContent = 'Neuen Link generieren';
  });

  revokeBtn.addEventListener('click', async () => {
    if (!confirm('Link wirklich widerrufen?')) return;
    const fd = new FormData();
    fd.append('action', 'revoke');
    fd.append('id', tid);
    try {
      await fetch('/admin/teilnehmer_token_ajax.php', { method: 'POST', body: fd });
    } catch {}
    loadStatus();
    urlWrap.style.display = 'none';
  });

  copyBtn.addEventListener('click', async () => {
    try {
      await navigator.clipboard.writeText(urlInput.value);
      copyBtn.textContent = '✓ Kopiert';
      setTimeout(() => { copyBtn.innerHTML = '<i class="fa-regular fa-copy"></i> Kopieren'; }, 2000);
    } catch {
      urlInput.select();
    }
  });
})();
</script>
{% endif %}
{% endblock %}
