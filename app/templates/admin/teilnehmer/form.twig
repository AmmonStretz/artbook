{% extends 'base.twig' %}

{% block head_extra %}
<link rel="stylesheet" href="/assets/tiptap/tiptap.css">
{% endblock %}

{% block content %}
{% if is_copy %}
  <div class="alert" style="max-width:680px;background:#f0f9ff;border:1px solid #bae6fd;color:#0c4a6e;padding:.75rem 1rem;border-radius:.5rem;margin-bottom:1.25rem;font-size:.875rem">
    Kopie von: <strong>{{ fetched_name }}</strong>
  </div>
{% endif %}
{% if errors %}
  <div class="alert alert-error" style="max-width:680px">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
{% endif %}

<div style="max-width:680px;display:flex;flex-direction:column;gap:1.25rem">

  <form method="post" id="main-form" novalidate>
  <div class="card">
    <div class="card-header">
      <span class="card-title">{{ page_title }}</span>
      <a href="/admin/teilnehmer/" class="btn btn-ghost btn-sm">← Zurück zur Liste</a>
    </div>
    <div class="card-body">

      <div class="form-grid">
        <div class="form-group">
          <label for="name">Name <span class="req">*</span></label>
          <input type="text" id="name" name="name" value="{{ v.name }}" required autofocus>
        </div>

        <div class="form-group">
          <label for="kategorie">Kategorie <span class="req">*</span></label>
          <select id="kategorie" name="kategorie" required>
            {% for key, label in TEILNEHMER_KATEGORIEN %}
              <option value="{{ key }}" {{ v.kategorie == key ? 'selected' : '' }}>{{ label }}</option>
            {% endfor %}
          </select>
        </div>

        <div class="form-group span-2">
          <label for="link">Link <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
          <input type="text" id="link" name="link" value="{{ v.link }}" placeholder="https://…">
        </div>

        <div class="form-group span-2">
          <label>Beschreibung <span style="color:var(--text-muted);font-weight:400">(optional)</span></label>
          <div class="lang-tabs">
            <button type="button" class="lang-tab active" onclick="switchDescLang(this,'de')">DE</button>
            <button type="button" class="lang-tab" onclick="switchDescLang(this,'en')">EN</button>
          </div>
          <div class="lang-panel" id="desc-panel-de">
            <div id="quill-editor"></div>
            <input type="hidden" name="beschreibung" id="beschreibung-input" value="{{ v.beschreibung }}">
          </div>
          <div class="lang-panel" id="desc-panel-en" style="display:none">
            <div id="quill-editor-en"></div>
            <input type="hidden" name="beschreibung_en" id="beschreibung-en-input" value="{{ v.beschreibung_en|default('') }}">
          </div>
        </div>
      </div>

      <div class="form-actions">
        <button type="submit" name="action" value="save" class="btn btn-primary">
          {{ is_edit ? 'Änderungen speichern' : (is_copy ? 'Kopie erstellen' : 'Teilnehmer erstellen') }}
        </button>
        <a href="/admin/teilnehmer/" class="btn btn-secondary">Abbrechen</a>
      </div>

    </div>
  </div>
  </form>

  {% if is_edit %}
  {% if is_gruppe %}
  {# Gruppe: zeige Mitglieder #}
  <div class="card">
    <div class="card-header">
      <span class="card-title">Mitglieder</span>
      <span style="color:var(--text-muted);font-size:.8125rem;font-weight:400">
        {{ members|length }} {{ members|length == 1 ? 'Mitglied' : 'Mitglieder' }}
      </span>
    </div>
    <div class="card-body" style="padding:0">
      {% if members %}
        <ul class="member-list">
          {% for m in members %}
            <li class="member-item">
              <a href="/admin/teilnehmer/form.php?id={{ m.id }}" class="member-name">
                {{ m.name }}
                <span class="badge badge-type" style="font-size:.7rem;margin-left:.375rem">
                  {{ TEILNEHMER_KATEGORIEN[m.kategorie]|default(m.kategorie) }}
                </span>
              </a>
              <form method="post" style="margin:0">
                <input type="hidden" name="action" value="remove_mitglied">
                <input type="hidden" name="mitglied_id" value="{{ m.id }}">
                <button type="submit" class="btn btn-ghost btn-sm member-remove" title="Entfernen">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </form>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="member-empty">Noch keine Mitglieder zugeordnet.</p>
      {% endif %}
      <div class="member-add-wrap" style="flex-direction:column;gap:.75rem">
        {% if available %}
          <form method="post" class="member-add-form">
            <input type="hidden" name="action" value="add_mitglied">
            <div style="flex:1;display:flex;flex-direction:column;gap:.375rem">
              <input type="search" id="rel-search" placeholder="Teilnehmer suchen …"
                     class="search-input" style="width:100%" autocomplete="off">
              <select name="mitglied_id" id="rel-select" class="member-add-select" required size="1">
                <option value="">– Teilnehmer auswählen –</option>
                {% for a in available %}
                  <option value="{{ a.id }}">{{ a.name }} ({{ TEILNEHMER_KATEGORIEN[a.kategorie]|default(a.kategorie) }})</option>
                {% endfor %}
              </select>
            </div>
            <button type="submit" class="btn btn-primary btn-sm" style="align-self:flex-end">Hinzufügen</button>
          </form>
        {% else %}
          <p style="color:var(--text-muted);font-size:.8125rem">Alle vorhandenen Teilnehmer sind bereits zugeordnet.</p>
        {% endif %}
        <form method="post" class="member-add-form" style="border-top:1px solid var(--border);padding-top:.75rem">
          <input type="hidden" name="action" value="create_mitglied">
          <div style="flex:1;display:flex;flex-direction:column;gap:.25rem">
            <span style="font-size:.8125rem;color:var(--text-muted);font-weight:500">Neuen Künstler erstellen &amp; hinzufügen</span>
            <input type="text" name="new_mitglied_name" placeholder="Name …"
                   class="search-input" style="width:100%" autocomplete="off">
          </div>
          <button type="submit" class="btn btn-secondary btn-sm" style="align-self:flex-end">Erstellen</button>
        </form>
      </div>
    </div>
  </div>

  {% else %}
  {# Künstler: zeige Gruppen, bei denen er Mitglied ist #}
  <div class="card">
    <div class="card-header">
      <span class="card-title">Mitglied bei</span>
      <span style="color:var(--text-muted);font-size:.8125rem;font-weight:400">
        {{ mitglied_bei|length }} {{ mitglied_bei|length == 1 ? 'Gruppe' : 'Gruppen' }}
      </span>
    </div>
    <div class="card-body" style="padding:0">
      {% if mitglied_bei %}
        <ul class="member-list">
          {% for g in mitglied_bei %}
            <li class="member-item">
              <a href="/admin/teilnehmer/form.php?id={{ g.id }}" class="member-name">
                {{ g.name }}
                <span class="badge badge-type" style="font-size:.7rem;margin-left:.375rem">
                  {{ TEILNEHMER_KATEGORIEN[g.kategorie]|default(g.kategorie) }}
                </span>
              </a>
              <form method="post" style="margin:0">
                <input type="hidden" name="action" value="remove_gruppe">
                <input type="hidden" name="gruppe_id" value="{{ g.id }}">
                <button type="submit" class="btn btn-ghost btn-sm member-remove" title="Entfernen">
                  <i class="fa-solid fa-xmark" aria-hidden="true"></i>
                </button>
              </form>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="member-empty">Noch keiner Gruppe zugeordnet.</p>
      {% endif %}
      <div class="member-add-wrap">
        {% if available %}
          <form method="post" class="member-add-form">
            <input type="hidden" name="action" value="add_gruppe">
            <div style="flex:1;display:flex;flex-direction:column;gap:.375rem">
              <input type="search" id="rel-search" placeholder="Gruppe suchen …"
                     class="search-input" style="width:100%" autocomplete="off">
              <select name="gruppe_id" id="rel-select" class="member-add-select" required size="1">
                <option value="">– Gruppe auswählen –</option>
                {% for a in available %}
                  <option value="{{ a.id }}">{{ a.name }} ({{ TEILNEHMER_KATEGORIEN[a.kategorie]|default(a.kategorie) }})</option>
                {% endfor %}
              </select>
            </div>
            <button type="submit" class="btn btn-primary btn-sm" style="align-self:flex-end">Hinzufügen</button>
          </form>
        {% else %}
          <p style="color:var(--text-muted);font-size:.8125rem">Alle Gruppen sind bereits zugeordnet.</p>
        {% endif %}
      </div>
    </div>
  </div>
  {% endif %}
  {% endif %}

</div>

{% if is_edit %}
  <div class="card" style="margin-top:1.25rem;max-width:680px">
    <div class="card-header">
      <span class="card-title">Veranstaltungen</span>
      <span style="color:var(--text-muted);font-size:.8125rem;font-weight:400">
        {{ veranstaltungen|length }} {{ veranstaltungen|length == 1 ? 'Veranstaltung' : 'Veranstaltungen' }}
      </span>
    </div>
    <div class="card-body" style="padding:0">
      {% if veranstaltungen %}
        <ul class="member-list">
          {% for v in veranstaltungen %}
            <li class="member-item">
              <a href="/admin/veranstaltungen/form.php?id={{ v.id }}" class="member-name">
                {{ v.name }}
                {% if v.erster_tag %}
                  <span style="color:var(--text-muted);font-size:.8125rem;font-weight:400;margin-left:.375rem">
                    {{ v.erster_tag|date('d.m.Y') }}
                  </span>
                {% endif %}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p class="member-empty">Noch keiner Veranstaltung zugeordnet.</p>
      {% endif %}
    </div>
  </div>

  {% include 'bilder/_section.twig' with {'bild_tid': id, 'bilder': bilder} %}

{% endif %}
{% endblock %}

{% block scripts %}
<script type="module">
import { mkEditor, edHTML } from '/assets/tiptap/init.js';

const edDE = mkEditor(document.getElementById('quill-editor'),    { placeholder: 'Beschreibung eingeben …', initialHTML: {{ v.beschreibung|default('')|json_encode|raw }} });
const edEN = mkEditor(document.getElementById('quill-editor-en'), { placeholder: 'Description …',           initialHTML: {{ v.beschreibung_en|default('')|json_encode|raw }} });

window.switchDescLang = function(btn, lang) {
  btn.closest('.lang-tabs').querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('desc-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('desc-panel-en').style.display = lang === 'en' ? '' : 'none';
};

document.getElementById('main-form').addEventListener('submit', () => {
  document.getElementById('beschreibung-input').value    = edHTML(edDE);
  document.getElementById('beschreibung-en-input').value = edHTML(edEN);
});

const relSearch = document.getElementById('rel-search');
const relSelect = document.getElementById('rel-select');
if (relSearch && relSelect) {
  const allOptions = Array.from(relSelect.options).map(o => ({ el: o, text: o.text.toLowerCase() }));
  relSearch.addEventListener('input', () => {
    const term = relSearch.value.toLowerCase();
    allOptions.forEach(({ el, text }) => {
      el.hidden = el.value === '' ? false : !text.includes(term);
    });
    if (relSelect.selectedOptions[0]?.hidden) relSelect.value = '';
  });
}
</script>

{% endblock %}
