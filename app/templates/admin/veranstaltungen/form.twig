{% extends 'base.twig' %}

{% block head_extra %}
<link rel="stylesheet" href="/assets/flatpickr/flatpickr.min.css">
<link rel="stylesheet" href="/assets/tiptap/tiptap.css">
{% endblock %}

{% block content %}
{% if is_copy %}
  <div class="alert alert-info" style="max-width:860px;background:#f0f9ff;border-color:#bae6fd;color:#0c4a6e">
    Kopie von: <strong>{{ fetched_name }}</strong> — Bitte Daten prüfen und anpassen.
  </div>
{% endif %}

{% if errors %}
  <div class="alert alert-error" style="max-width:860px">
    {% for e in errors %}<div>{{ e }}</div>{% endfor %}
  </div>
{% endif %}

<form method="post" id="main-form" style="max-width:860px" novalidate>
  <div class="card">
    <div class="card-header">
      <span class="card-title">{{ page_title }}</span>
      <a href="/admin/veranstaltungen/" class="btn btn-ghost btn-sm">← Zurück zur Liste</a>
    </div>
    <div class="card-body">

      <div class="lang-tabs" style="margin-bottom:.25rem">
        <button type="button" class="lang-tab active" onclick="switchFormLang(this,'de')">DE</button>
        <button type="button" class="lang-tab" onclick="switchFormLang(this,'en')">EN</button>
      </div>

      <div class="lang-panel" id="form-panel-de">
        <div class="form-grid">
          <div class="form-group span-2">
            <label for="name">Name <span class="req">*</span></label>
            <input type="text" id="name" name="name" value="{{ v.name }}" required autofocus>
          </div>
          <div class="form-group span-2">
            <label>Kurzbeschreibung</label>
            <div id="quill-editor-kurz"></div>
            <input type="hidden" name="kurzbeschreibung" id="kurzbeschreibung-input"
                   value="{{ v.kurzbeschreibung|default('') }}">
          </div>
          <div class="form-group span-2">
            <label>Beschreibung</label>
            <div id="quill-editor"></div>
            <input type="hidden" name="beschreibung" id="beschreibung-input"
                   value="{{ v.beschreibung|default('') }}">
          </div>
        </div>
      </div>

      <div class="lang-panel" id="form-panel-en" style="display:none">
        <div class="form-grid">
          <div class="form-group span-2">
            <label for="name_en">Name <span style="color:var(--text-muted);font-weight:400">(EN, optional)</span></label>
            <input type="text" id="name_en" name="name_en" value="{{ v.name_en|default('') }}">
          </div>
          <div class="form-group span-2">
            <label>Kurzbeschreibung <span style="color:var(--text-muted);font-weight:400">(EN, optional)</span></label>
            <div id="quill-editor-kurz-en"></div>
            <input type="hidden" name="kurzbeschreibung_en" id="kurzbeschreibung-en-input"
                   value="{{ v.kurzbeschreibung_en|default('') }}">
          </div>
          <div class="form-group span-2">
            <label>Beschreibung <span style="color:var(--text-muted);font-weight:400">(EN, optional)</span></label>
            <div id="quill-editor-en"></div>
            <input type="hidden" name="beschreibung_en" id="beschreibung-en-input"
                   value="{{ v.beschreibung_en|default('') }}">
          </div>
        </div>
      </div>

      <div class="form-grid">

        <div class="form-group span-2">
          <label class="checkbox-label">
            <input type="checkbox" name="sichtbar" value="1" {{ v.sichtbar ? 'checked' : '' }}>
            <span>Veranstaltung anzeigen (veröffentlicht)</span>
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="programm_sichtbar" value="1" {{ v.programm_sichtbar ? 'checked' : '' }}>
            <span>Programm anzeigen</span>
          </label>
        </div>
        <div class="form-group">
          <label class="checkbox-label">
            <input type="checkbox" name="teilnehmer_sichtbar" value="1" {{ v.teilnehmer_sichtbar ? 'checked' : '' }}>
            <span>Teilnehmer anzeigen</span>
          </label>
        </div>
      </div>

      <div class="form-section">
        <div class="form-section-title">Veranstaltungsort</div>

        <input type="hidden" name="veranstaltungsort_id" id="veranstaltungsort_id"
               value="{{ v.veranstaltungsort_id|default('') }}">

        {# Ausgewählter Ort — Karte #}
        <div id="ort-selected" {% if not v.veranstaltungsort_id %}style="display:none"{% endif %}>
          <div style="border:1px solid var(--border);border-radius:.5rem;padding:.875rem 1rem;
                      background:var(--bg-muted,#f8fafc);display:flex;justify-content:space-between;
                      align-items:flex-start;gap:1rem">
            <div style="min-width:0">
              <div style="font-weight:600;font-size:.9375rem;margin-bottom:.2rem" id="ort-card-name">
                {{ current_ort.name|default('') }}
              </div>
              <div style="font-size:.875rem;color:var(--text-muted)" id="ort-card-addr">
                {% if current_ort %}
                  {% set addr_parts = [] %}
                  {% if current_ort.strasse %}{% set addr_parts = addr_parts|merge([current_ort.strasse]) %}{% endif %}
                  {% set city = (current_ort.plz ~ ' ' ~ current_ort.ort)|trim %}
                  {% if city %}{% set addr_parts = addr_parts|merge([city]) %}{% endif %}
                  {% if current_ort.land and current_ort.land != 'Deutschland' %}{% set addr_parts = addr_parts|merge([current_ort.land]) %}{% endif %}
                  {{ addr_parts|join(', ') }}
                {% endif %}
              </div>
              {% if current_ort and current_ort.lat %}
                <div style="font-size:.8125rem;color:var(--text-muted);margin-top:.25rem" id="ort-card-coords">
                  {{ current_ort.lat }}, {{ current_ort.lng }}
                </div>
              {% else %}
                <div style="display:none" id="ort-card-coords"></div>
              {% endif %}
            </div>
            <div style="display:flex;flex-direction:column;gap:.375rem;flex-shrink:0;align-items:flex-end">
              <a href="/admin/orte/form.php?id={{ v.veranstaltungsort_id|default('') }}"
                 id="ort-edit-link" target="_blank"
                 class="btn btn-ghost btn-sm" style="white-space:nowrap">
                Bearbeiten ↗
              </a>
              <button type="button" class="btn btn-ghost btn-sm" style="white-space:nowrap"
                      onclick="clearOrtPicker()">Ort ändern</button>
            </div>
          </div>
        </div>

        {# Picker — sichtbar wenn kein Ort ausgewählt #}
        <div id="ort-picker-wrap" {% if v.veranstaltungsort_id %}style="display:none"{% endif %}>
          <div style="position:relative;margin-bottom:.625rem">
            <input type="text" id="ort-picker-q" autocomplete="off"
                   placeholder="Gespeicherten Ort suchen …" style="width:100%">
            <div id="ort-picker-dropdown" style="display:none;position:absolute;z-index:200;top:100%;left:0;right:0;
                 background:var(--bg-card,#fff);border:1px solid var(--border);
                 border-radius:0 0 .375rem .375rem;box-shadow:0 4px 12px rgba(0,0,0,.1);
                 max-height:280px;overflow-y:auto"></div>
          </div>
          <button type="button" class="btn btn-secondary btn-sm" id="ort-create-open">
            <i class="fa-solid fa-plus"></i> Neuer Ort anlegen
          </button>
        </div>

      </div>

      <div class="form-section">
        <div class="form-section-title">Veranstaltungstage & Programm <span class="req">*</span></div>

        <div id="tage-container" class="tag-tiles">
          {% for t in tage %}
            {% set datum      = t.datum|default('') %}
            {% set prog_items = prog_by_date[datum]|default([]) %}
            {% set show_prog  = is_edit and datum != '' %}
            <div class="tag-tile">
              <div class="tag-tile-fields{{ not show_prog ? ' no-prog' : '' }}">
                <div>
                  <label class="tag-field-label">Datum <span class="req">*</span></label>
                  <input class="fp-date" type="text" name="tag_datum[]" value="{{ datum }}">
                </div>
                <div>
                  <label class="tag-field-label">Von <span class="req">*</span></label>
                  <input class="fp-time" type="text" name="tag_startzeit[]"
                         value="{{ t.startzeit|default('')|slice(0, 5) }}">
                </div>
                <div>
                  <label class="tag-field-label">Bis <span class="req">*</span></label>
                  <input class="fp-time" type="text" name="tag_endzeit[]"
                         value="{{ t.endzeit|default('')|slice(0, 5) }}">
                </div>
                <button type="button" class="btn btn-ghost btn-icon remove-tag" title="Tag entfernen">
                  <i class="fa-solid fa-trash" aria-hidden="true"></i>
                </button>
              </div>
              {% if show_prog %}
                <div class="tag-tile-prog" data-datum="{{ datum }}">
                  {% for e in prog_items %}
                    <div class="tag-tile-prog-item">
                      <div class="tag-tile-prog-time">{{ e.uhrzeit|slice(0, 5) }}</div>
                      <div class="tag-tile-prog-body">
                        <div class="tag-tile-prog-title">{{ e.titel|striptags }}</div>
                        {% if e.ort_name %}
                          <div class="tag-tile-prog-loc">{{ e.ort_name }}</div>
                        {% endif %}
                      </div>
                      <div class="tag-tile-prog-actions">
                        <button type="button" class="btn btn-ghost btn-sm"
                                onclick="openProgDialog({{ e.id }}, '{{ datum }}')">Bearbeiten</button>
                        <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger)"
                                onclick="deleteProgEntry({{ e.id }}, '{{ datum }}')">Löschen</button>
                      </div>
                    </div>
                  {% else %}
                    <div class="tag-tile-empty">Noch keine Programmpunkte für diesen Tag.</div>
                  {% endfor %}
                  <a href="#" class="tag-tile-add"
                     onclick="openProgDialog(null, '{{ datum }}'); return false;">
                    <i class="fa-solid fa-plus"></i>
                    Programmpunkt hinzufügen
                  </a>
                </div>
              {% endif %}
            </div>
          {% endfor %}
        </div>

        <button type="button" id="add-tag" class="btn btn-secondary btn-sm" style="margin-top:.5rem">
          <i class="fa-solid fa-plus"></i>
          Tag hinzufügen
        </button>
      </div>

      <div id="form-flash" hidden style="margin-bottom:.75rem"></div>
      <div class="form-actions">
        <button type="submit" class="btn btn-primary" id="form-submit-btn">
          {{ is_edit ? 'Änderungen speichern' : (is_copy ? 'Kopie erstellen' : 'Veranstaltung erstellen') }}
        </button>
        <a href="/admin/veranstaltungen/" class="btn btn-secondary">Abbrechen</a>
      </div>

    </div>
  </div>
</form>

{# Dialog: Neuer Veranstaltungsort #}
<dialog id="ort-create-dialog" style="border:none;border-radius:.5rem;padding:0;width:min(520px,95vw);
        box-shadow:0 8px 32px rgba(0,0,0,.18)">
  <div style="display:flex;align-items:center;justify-content:space-between;
              padding:.875rem 1.25rem;border-bottom:1px solid var(--border)">
    <span style="font-weight:600">Neuer Veranstaltungsort</span>
    <button type="button" id="ort-create-close" class="btn btn-ghost btn-sm">✕</button>
  </div>
  <div style="padding:1.25rem">
    <div id="ort-create-error" class="alert alert-error" style="display:none;margin-bottom:1rem"></div>
    <div class="form-grid">
      <div class="form-group span-2">
        <label>Name <span class="req">*</span></label>
        <input type="text" id="ort-create-name" autocomplete="off"
               placeholder="z.B. Kunstquartier Bethanien">
      </div>
      <div class="form-group span-2">
        <label style="font-weight:400">Straße & Hausnummer</label>
        <input type="text" id="ort-create-strasse" autocomplete="off">
      </div>
      <div class="form-group">
        <label style="font-weight:400">PLZ</label>
        <input type="text" id="ort-create-plz" autocomplete="off">
      </div>
      <div class="form-group">
        <label style="font-weight:400">Ort</label>
        <input type="text" id="ort-create-ort" autocomplete="off">
      </div>
      <div class="form-group span-2">
        <label style="font-weight:400">Land</label>
        <input type="text" id="ort-create-land" value="Deutschland" autocomplete="off">
      </div>
      <div class="form-group span-2">
        <label style="font-weight:400;color:var(--text-muted)">Website <span style="font-size:.8125rem">(optional)</span></label>
        <input type="text" id="ort-create-url" placeholder="https://…" autocomplete="off">
      </div>
    </div>
    <p style="font-size:.8125rem;color:var(--text-muted);margin-top:.75rem">
      Koordinaten können nach dem Erstellen im
      <a href="/admin/orte/" target="_blank">Orte-Admin</a> ergänzt werden.
    </p>
  </div>
  <div style="padding:.875rem 1.25rem;border-top:1px solid var(--border);
              display:flex;justify-content:flex-end;gap:.5rem">
    <button type="button" class="btn btn-secondary" id="ort-create-cancel">Abbrechen</button>
    <button type="button" class="btn btn-primary"   id="ort-create-submit">Ort erstellen & auswählen</button>
  </div>
</dialog>

{% if is_edit %}
<div style="max-width:860px;margin-top:1.25rem">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Teilnehmer</span>
      <span id="tn-count" style="color:var(--text-muted);font-size:.8125rem;font-weight:400">–</span>
    </div>
    <div style="padding:.75rem 1.25rem;border-bottom:1px solid var(--border)">
      <input type="search" id="tn-list-q" placeholder="Suchen …" class="search-input"
             style="width:100%;max-width:320px" autocomplete="off">
    </div>
    <div style="padding:0">
      <div id="tn-list-wrap"><p class="member-empty" style="padding:1rem 1.25rem">Laden …</p></div>
      <div id="tn-list-pagination"></div>
      <div class="member-add-wrap">
        <button type="button" class="btn btn-primary btn-sm" id="tn-open-dialog">
          <i class="fa-solid fa-plus"></i>
          Vorhandenen hinzufügen
        </button>
        <button type="button" class="btn btn-secondary btn-sm" id="tn-create-open">
          <i class="fa-solid fa-user-plus"></i>
          Neu erstellen
        </button>
      </div>
    </div>
  </div>
</div>

<div style="max-width:860px;margin-top:1.25rem">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Muster</span>
      <label class="btn btn-primary btn-sm" style="cursor:pointer">
        <i class="fa-solid fa-upload"></i>
        {{ v.muster|default('') ? 'Ersetzen' : 'Hochladen' }}
        <input type="file" id="muster-input" accept=".jpg,.jpeg,.png,.webp,.svg" hidden>
      </label>
    </div>
    <div class="card-body">
      <p class="bild-hint">
        Mindestens {{ IMG_MUSTER_MIN_WIDTH }} px Breite für Rasterbilder &nbsp;·&nbsp;
        Wird in 8 WebP-Größen zugeschnitten (Fullpage + Banner) &nbsp;·&nbsp;
        JPEG, PNG, WebP oder SVG (SVG wird direkt gespeichert)
      </p>
      <div id="muster-error"></div>
      <div id="muster-wrap">
        {% if v.muster|default('') %}
          {% if v.muster ends with '.svg' %}
            <div class="titelbild-preview">
              <img src="{{ IMG_MUSTER_UPLOAD_URL ~ v.muster }}"
                   alt="Muster" class="titelbild-img" style="background:#f1f5f9">
              <button type="button" class="btn btn-ghost btn-sm"
                      style="color:var(--danger);margin-top:.625rem"
                      onclick="musterDelete()">Muster entfernen</button>
            </div>
          {% else %}
            {% set m_stem = v.muster|split('.')|first %}
            <div class="titelbild-preview">
              <img src="{{ IMG_MUSTER_UPLOAD_URL ~ m_stem ~ '_fp_lg.webp' }}"
                   alt="Muster" class="titelbild-img"
                   onclick="musterPreview('{{ (IMG_MUSTER_UPLOAD_URL ~ m_stem ~ '_fp_xl.webp')|escape('js') }}')">
              <button type="button" class="btn btn-ghost btn-sm"
                      style="color:var(--danger);margin-top:.625rem"
                      onclick="musterDelete()">Muster entfernen</button>
            </div>
          {% endif %}
        {% else %}
          <p class="bild-empty">Kein Muster hochgeladen.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<div style="max-width:860px;margin-top:1.25rem">
  <div class="card">
    <div class="card-header">
      <span class="card-title">Logo</span>
      <label class="btn btn-primary btn-sm" style="cursor:pointer">
        <i class="fa-solid fa-upload"></i>
        {{ v.logo|default('') ? 'Ersetzen' : 'Hochladen' }}
        <input type="file" id="logo-input" accept=".jpg,.jpeg,.png,.svg" hidden>
      </label>
    </div>
    <div class="card-body">
      <p class="bild-hint">
        JPEG, PNG oder SVG &nbsp;·&nbsp; Wird unverändert gespeichert
      </p>
      <div id="logo-error"></div>
      <div id="logo-wrap">
        {% if v.logo|default('') %}
          <div class="titelbild-preview">
            <img src="{{ IMG_LOGO_UPLOAD_URL ~ v.logo }}"
                 alt="Logo" style="max-height:120px;max-width:240px;object-fit:contain;background:#f1f5f9;padding:.5rem;border-radius:4px">
            <button type="button" class="btn btn-ghost btn-sm"
                    style="color:var(--danger);margin-top:.625rem"
                    onclick="logoDelete()">Logo entfernen</button>
          </div>
        {% else %}
          <p class="bild-empty">Kein Logo hochgeladen.</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>

<dialog id="muster-preview-dialog" class="bild-preview-dialog">
  <div class="bild-preview-header">
    <span style="color:#e2e8f0;font-size:.8125rem">{{ v.name }}</span>
    <button type="button" class="btn btn-ghost btn-sm" style="color:#e2e8f0"
            onclick="document.getElementById('muster-preview-dialog').close()">✕</button>
  </div>
  <img id="muster-preview-img" src="" alt=""
       style="display:block;max-width:88vw;max-height:80vh;object-fit:contain">
</dialog>

<dialog id="tn-dialog" class="tn-dialog">
  <div class="tn-dialog-header">
    <span class="tn-dialog-title">Teilnehmer hinzufügen</span>
    <button type="button" id="tn-close" class="btn btn-ghost btn-sm">✕</button>
  </div>
  <div class="tn-dialog-toolbar">
    <input type="search" id="tn-q" placeholder="Suchen …" class="search-input"
           style="flex:1;width:auto" autocomplete="off">
    <select id="tn-typ" style="width:auto">
      <option value="">Alle</option>
      <option value="kuenstler">Künstler</option>
      <option value="gruppe">Gruppen</option>
    </select>
  </div>
  <div id="tn-body" class="tn-dialog-body"></div>
  <div id="tn-footer" class="tn-dialog-footer"></div>
</dialog>

<dialog id="tn-create-dialog" class="tn-dialog">
  <div class="tn-dialog-header">
    <span class="tn-dialog-title">Neuen Teilnehmer erstellen</span>
    <button type="button" id="tn-create-close" class="btn btn-ghost btn-sm">✕</button>
  </div>
  <div class="tn-dialog-body" style="padding:1.25rem;overflow-y:auto">
    <div id="tn-create-error" class="alert alert-error" style="margin-bottom:1rem;display:none"></div>
    <div class="form-grid">
      <div class="form-group">
        <label for="tn-create-typ">Typ <span class="req">*</span></label>
        <select id="tn-create-typ">
          <option value="kuenstler">Künstler</option>
          <option value="gruppe">Gruppe</option>
        </select>
      </div>
      <div class="form-group" id="tn-create-gruppe-typ-wrap" style="display:none">
        <label for="tn-create-gruppe-typ">Gruppentyp <span class="req">*</span></label>
        <select id="tn-create-gruppe-typ">
          {% for key, label in GRUPPE_TYPEN %}
            <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-group span-2">
        <label for="tn-create-name">Name <span class="req">*</span></label>
        <input type="text" id="tn-create-name" placeholder="Name …" autocomplete="off">
      </div>
      <div class="form-group span-2">
        <label for="tn-create-tischnr" style="font-weight:400;color:var(--text-muted)">
          Tischnummer <span style="font-size:.8125rem">(optional)</span>
        </label>
        <input type="text" id="tn-create-tischnr" placeholder="z.B. 12" autocomplete="off"
               style="max-width:120px">
      </div>
      <div class="form-group span-2">
        <label class="checkbox-label">
          <input type="checkbox" id="tn-create-add-to-event" checked>
          <span>Direkt zur Veranstaltung hinzufügen</span>
        </label>
      </div>
    </div>
  </div>
  <div class="tn-dialog-footer" style="justify-content:flex-end;gap:.5rem">
    <button type="button" class="btn btn-secondary" id="tn-create-cancel">Abbrechen</button>
    <button type="button" class="btn btn-primary" id="tn-create-submit">Erstellen</button>
  </div>
</dialog>

<dialog id="tn-edit-dialog" class="tn-dialog">
  <div class="tn-dialog-header">
    <span class="tn-dialog-title" id="tn-edit-title">Teilnehmer bearbeiten</span>
    <button type="button" id="tn-edit-close" class="btn btn-ghost btn-sm">✕</button>
  </div>
  <div class="tn-dialog-body" style="padding:1.25rem;overflow-y:auto">
    <div id="tn-edit-error" class="alert alert-error" style="display:none;margin-bottom:1rem"></div>
    <input type="hidden" id="tn-edit-id">
    <div class="form-grid">
      <div class="form-group span-2">
        <label>Name <span class="req">*</span></label>
        <input type="text" id="tn-edit-name" autocomplete="off">
      </div>
      <div class="form-group span-2" id="tn-edit-gruppe-typ-wrap" style="display:none">
        <label>Gruppentyp <span class="req">*</span></label>
        <select id="tn-edit-gruppe-typ">
          {% for key, label in GRUPPE_TYPEN %}
            <option value="{{ key }}">{{ label }}</option>
          {% endfor %}
        </select>
      </div>
      <div class="form-group span-2">
        <label style="font-weight:400;color:var(--text-muted)">Link <span style="font-size:.8125rem">(optional)</span></label>
        <input type="text" id="tn-edit-link" placeholder="https://…" autocomplete="off">
      </div>
      <div class="form-group span-2">
        <label style="font-weight:400;color:var(--text-muted)">Beschreibung <span style="font-size:.8125rem">(optional)</span></label>
        <div class="lang-tabs">
          <button type="button" class="lang-tab active" onclick="switchTnEditLang(this,'de')">DE</button>
          <button type="button" class="lang-tab" onclick="switchTnEditLang(this,'en')">EN</button>
        </div>
        <div class="lang-panel" id="tn-edit-panel-de">
          <div id="tn-edit-quill"></div>
