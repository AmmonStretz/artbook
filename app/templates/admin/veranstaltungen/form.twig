<script>
const tnVid        = {{ id }};
const tnDialog     = document.getElementById('tn-dialog');
let   tnPage       = 1;

let currentGruppeId = null;
let gmPage = 1;
let gkPage = 1;
let gkAdded = 0;
let gkTimer = null;

function buildPageLinks(page, pages, gotoFn) {
  const s = Math.max(1, page - 2);
  const e = Math.min(pages, page + 2);
  let h = '';
  if (s > 1) {
    h += `<button type="button" class="page-link" onclick="${gotoFn}(1)">1</button>`;
    if (s > 2) h += '<span class="page-ellipsis"><i class="fa-solid fa-ellipsis"></i></span>';
  }
  for (let i = s; i <= e; i++)
    h += i === page
      ? `<span class="page-link active">${i}</span>`
      : `<button type="button" class="page-link" onclick="${gotoFn}(${i})">${i}</button>`;
  if (e < pages) {
    if (e < pages - 1) h += '<span class="page-ellipsis"><i class="fa-solid fa-ellipsis"></i></span>';
    h += `<button type="button" class="page-link" onclick="${gotoFn}(${pages})">${pages}</button>`;
  }
  return h;
}
let   tnAdded      = 0;
let   tnTimer      = null;

document.getElementById('tn-open-dialog').addEventListener('click', () => {
  tnPage = 1; tnAdded = 0;
  document.getElementById('tn-q').value   = '';
  document.getElementById('tn-typ').value = '';
  tnDialog.showModal();
  loadTn();
});

document.getElementById('tn-close').addEventListener('click', () => tnDialog.close());
tnDialog.addEventListener('click', e => { if (e.target === tnDialog) tnDialog.close(); });
tnDialog.addEventListener('close', () => { if (tnAdded > 0) { tnAdded = 0; loadParticipants(); } });

document.getElementById('tn-q').addEventListener('input', () => {
  clearTimeout(tnTimer);
  tnTimer = setTimeout(() => { tnPage = 1; loadTn(); }, 280);
});
document.getElementById('tn-typ').addEventListener('change', () => { tnPage = 1; loadTn(); });

function escHtml(s) {
  return String(s).replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;').replace(/"/g,'&quot;');
}

async function loadTn() {
  const q   = document.getElementById('tn-q').value;
  const typ = document.getElementById('tn-typ').value;
  document.getElementById('tn-body').innerHTML   = '<p class="tn-loading">Laden …</p>';
  document.getElementById('tn-footer').innerHTML = '';
  try {
    const r = await fetch(
      `/admin/veranstaltungen/teilnehmer_ajax.php?veranstaltung_id=${tnVid}&q=${encodeURIComponent(q)}&typ=${encodeURIComponent(typ)}&page=${tnPage}`
    );
    renderTn(await r.json());
  } catch {
    document.getElementById('tn-body').innerHTML = '<p class="tn-loading">Fehler beim Laden.</p>';
  }
}

function renderTn(data) {
  const body   = document.getElementById('tn-body');
  const footer = document.getElementById('tn-footer');

  if (!data.rows?.length) {
    body.innerHTML   = '<p class="member-empty">Keine Ergebnisse.</p>';
    footer.innerHTML = '';
    return;
  }

  body.innerHTML = data.rows.map(r => {
    const bc = r.typ === 'kuenstler' ? 'badge-kuenstler' : 'badge-type';
    const bl = r.typ === 'kuenstler' ? 'Künstler' : 'Gruppe';
    return `<div class="tn-row" data-id="${r.id}">
      <span class="badge ${bc}">${bl}</span>
      <span class="tn-row-name">${escHtml(r.name)}</span>
      <input type="text" class="tisch-input" placeholder="Tischnr." autocomplete="off">
      <button type="button" class="btn btn-primary btn-sm" onclick="addTn(${r.id},this)">Hinzufügen</button>
    </div>`;
  }).join('');

  const from = (data.page - 1) * data.per + 1;
  const to   = Math.min(data.page * data.per, data.total);
  let   pag  = `<span class="pagination-info">${from}–${to} von ${data.total}</span>`;
  if (data.pages > 1) {
    pag += '<div class="page-links">';
    pag += `<button type="button" class="page-link${data.page<=1?' disabled':''}" onclick="tnGo(${data.page-1})">‹</button>`;
    pag += buildPageLinks(data.page, data.pages, 'tnGo');
    pag += `<button type="button" class="page-link${data.page>=data.pages?' disabled':''}" onclick="tnGo(${data.page+1})">›</button>`;
    pag += '</div>';
  }
  footer.innerHTML = pag;
}

function tnGo(page) { tnPage = page; loadTn(); }

