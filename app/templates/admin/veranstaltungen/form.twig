// ─── Teilnehmer bearbeiten ─────────────────────────────────────

function switchTnEditLang(btn, lang) {
  document.querySelectorAll('#tn-edit-dialog .lang-tab').forEach(b => b.classList.remove('active'));
  if (btn) btn.classList.add('active');
  else document.querySelector(`#tn-edit-dialog .lang-tab[onclick*="'${lang}'"]`)?.classList.add('active');
  document.getElementById('tn-edit-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('tn-edit-panel-en').style.display = lang === 'en' ? '' : 'none';
}

const tnEditDialog = document.getElementById('tn-edit-dialog');

async function openTnEditDialog(tid) {
  window._tt.ensureTnEditEditor();
  const errEl = document.getElementById('tn-edit-error');
  errEl.style.display = 'none';
  document.getElementById('tn-edit-id').value = tid;
  document.getElementById('tn-edit-name').value = '';
  document.getElementById('tn-edit-link').value = '';
  document.getElementById('tn-edit-gruppe-typ-wrap').style.display = 'none';
  window._tt.tnEdit.commands.clearContent();
  window._tt.tnEditEN.commands.clearContent();
  switchTnEditLang(null, 'de');
  tnEditDialog.showModal();
  try {
    const r = await fetch(`/admin/veranstaltungen/teilnehmer_edit_ajax.php?id=${tid}`);
    const d = await r.json();
    if (!d.ok) return;
    const t = d.teilnehmer;
    document.getElementById('tn-edit-title').textContent =
      (t.typ === 'kuenstler' ? 'Künstler' : 'Gruppe') + ' bearbeiten';
    document.getElementById('tn-edit-name').value = t.name || '';
    document.getElementById('tn-edit-link').value = t.link || '';
    const membersEl = document.getElementById('tn-edit-gruppe-members');
    if (t.typ === 'gruppe') {
      document.getElementById('tn-edit-gruppe-typ-wrap').style.display = '';
      document.getElementById('tn-edit-gruppe-typ').value = t.gruppe_typ || '';
      membersEl.style.display = '';
      currentGruppeId = t.id;
      gmPage = 1;
      loadGruppeMitglieder(1);
    } else {
      membersEl.style.display = 'none';
      currentGruppeId = null;
    }
    if (t.beschreibung)    window._tt.tnEdit.commands.setContent(t.beschreibung);
    if (t.beschreibung_en) window._tt.tnEditEN.commands.setContent(t.beschreibung_en);
  } catch {}
}

document.getElementById('tn-edit-close').addEventListener('click',  () => tnEditDialog.close());
document.getElementById('tn-edit-cancel').addEventListener('click', () => tnEditDialog.close());
tnEditDialog.addEventListener('click', e => { if (e.target === tnEditDialog) tnEditDialog.close(); });
tnEditDialog.addEventListener('close', () => { currentGruppeId = null; });

document.getElementById('tn-edit-submit').addEventListener('click', async () => {
  const errEl = document.getElementById('tn-edit-error');
  errEl.style.display = 'none';
  const name = document.getElementById('tn-edit-name').value.trim();
  if (!name) { errEl.textContent = 'Name ist ein Pflichtfeld.'; errEl.style.display = ''; return; }

  const beschr    = window._tt.edHTML(window._tt.tnEdit);
  const beschr_en = window._tt.edHTML(window._tt.tnEditEN);

  const fd = new FormData();
  fd.append('id',              document.getElementById('tn-edit-id').value);
  fd.append('name',            name);
  fd.append('beschreibung',    beschr);
  fd.append('beschreibung_en', beschr_en);
  fd.append('link',            document.getElementById('tn-edit-link').value.trim());
  if (document.getElementById('tn-edit-gruppe-typ-wrap').style.display !== 'none')
    fd.append('gruppe_typ', document.getElementById('tn-edit-gruppe-typ').value);

  const btn = document.getElementById('tn-edit-submit');
  btn.disabled = true; btn.textContent = 'Speichern …';
  try {
    const r = await fetch('/admin/veranstaltungen/teilnehmer_edit_ajax.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) { tnEditDialog.close(); loadParticipants(); }
    else { errEl.textContent = d.error || 'Fehler.'; errEl.style.display = ''; }
  } catch { errEl.textContent = 'Fehler beim Speichern.'; errEl.style.display = ''; }
  finally { btn.disabled = false; btn.textContent = 'Speichern'; }
});

// ─── Gruppe Mitglieder (Künstler in Gruppe) ────────────────────

const gkDialog = document.getElementById('gruppe-k-dialog');

async function loadGruppeMitglieder(page) {
  gmPage = page ?? gmPage;
  document.getElementById('tn-edit-mitglieder-list').innerHTML = '<p class="member-empty">Laden …</p>';
  document.getElementById('tn-edit-mitglieder-pag').innerHTML  = '';
  try {
    const r = await fetch(`/admin/veranstaltungen/gruppe_members_ajax.php?gruppe_id=${currentGruppeId}&mode=members&page=${gmPage}`);
    renderGruppeMitglieder(await r.json());
  } catch {
    document.getElementById('tn-edit-mitglieder-list').innerHTML = '<p class="member-empty">Fehler beim Laden.</p>';
  }
}

function renderGruppeMitglieder(data) {
  const listEl = document.getElementById('tn-edit-mitglieder-list');
  const pagEl  = document.getElementById('tn-edit-mitglieder-pag');

  if (!data.rows?.length) {
    listEl.innerHTML = '<p class="member-empty">Noch keine Künstler zugeordnet.</p>';
    pagEl.innerHTML  = '';
    return;
  }

  listEl.innerHTML = '<ul class="member-list">' + data.rows.map(r =>
    `<li class="member-item">
      <span class="member-name">${escHtml(r.name)}</span>
      <button type="button" class="btn btn-ghost btn-sm member-remove"
              title="Entfernen" onclick="removeKuenstlerFromGruppe(${r.id})">
        <i class="fa-solid fa-xmark"></i>
      </button>
    </li>`
  ).join('') + '</ul>';

  if (data.pages > 1) {
    const from = (data.page - 1) * data.per + 1;
    const to   = Math.min(data.page * data.per, data.total);
    pagEl.innerHTML = `<div class="pagination" style="padding:.5rem .75rem">
      <span class="pagination-info">${from}–${to} von ${data.total}</span>
      <div class="page-links">
        <button type="button" class="page-link${data.page<=1?' disabled':''}" onclick="loadGruppeMitglieder(${data.page-1})">‹</button>
        ${buildPageLinks(data.page, data.pages, 'loadGruppeMitglieder')}
        <button type="button" class="page-link${data.page>=data.pages?' disabled':''}" onclick="loadGruppeMitglieder(${data.page+1})">›</button>
      </div>
    </div>`;
  } else {
    pagEl.innerHTML = '';
  }
}

async function removeKuenstlerFromGruppe(kid) {
  if (!currentGruppeId) return;
  const fd = new FormData();
  fd.append('gruppe_id',    currentGruppeId);
  fd.append('kuenstler_id', kid);
  fd.append('action',       'remove');
  try {
    const r = await fetch('/admin/veranstaltungen/gruppe_members_ajax.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) loadGruppeMitglieder();
  } catch {}
}

document.getElementById('tn-edit-add-kuenstler').addEventListener('click', () => {
  gkPage = 1; gkAdded = 0;
  document.getElementById('gk-q').value = '';
  gkDialog.showModal();
  loadGruppeAvailable();
});

document.getElementById('gk-close').addEventListener('click', () => gkDialog.close());
gkDialog.addEventListener('click', e => { if (e.target === gkDialog) gkDialog.close(); });
gkDialog.addEventListener('close', () => { if (gkAdded > 0) { gkAdded = 0; loadGruppeMitglieder(1); } });

document.getElementById('gk-q').addEventListener('input', () => {
  clearTimeout(gkTimer);
  gkTimer = setTimeout(() => { gkPage = 1; loadGruppeAvailable(); }, 280);
});

async function loadGruppeAvailable() {
  const q = document.getElementById('gk-q').value;
  document.getElementById('gk-body').innerHTML   = '<p class="tn-loading">Laden …</p>';
  document.getElementById('gk-footer').innerHTML = '';
  try {
    const r = await fetch(
      `/admin/veranstaltungen/gruppe_members_ajax.php?gruppe_id=${currentGruppeId}&mode=available&page=${gkPage}&q=${encodeURIComponent(q)}`
    );
    renderGruppeAvailable(await r.json());
  } catch {
    document.getElementById('gk-body').innerHTML = '<p class="tn-loading">Fehler beim Laden.</p>';
  }
}

function renderGruppeAvailable(data) {
  const body   = document.getElementById('gk-body');
  const footer = document.getElementById('gk-footer');

  if (!data.rows?.length) {
    body.innerHTML   = '<p class="member-empty">Keine Ergebnisse.</p>';
    footer.innerHTML = '';
    return;
  }

  body.innerHTML = data.rows.map(r =>
    `<div class="tn-row" data-id="${r.id}">
      <span class="tn-row-name">${escHtml(r.name)}</span>
      <button type="button" class="btn btn-primary btn-sm" onclick="addKuenstlerToGruppe(${r.id}, this)">Hinzufügen</button>
    </div>`
  ).join('');

  const from = (data.page - 1) * data.per + 1;
  const to   = Math.min(data.page * data.per, data.total);
  let   pag  = `<span class="pagination-info">${from}–${to} von ${data.total}</span>`;
  if (data.pages > 1) {
    pag += '<div class="page-links">';
    pag += `<button type="button" class="page-link${data.page<=1?' disabled':''}" onclick="gkGo(${data.page-1})">‹</button>`;
    pag += buildPageLinks(data.page, data.pages, 'gkGo');
    pag += `<button type="button" class="page-link${data.page>=data.pages?' disabled':''}" onclick="gkGo(${data.page+1})">›</button>`;
    pag += '</div>';
  }
  footer.innerHTML = pag;
}

function gkGo(page) { gkPage = page; loadGruppeAvailable(); }

async function addKuenstlerToGruppe(kid, btn) {
  if (!currentGruppeId) return;
  btn.disabled = true;
  const fd = new FormData();
  fd.append('gruppe_id',    currentGruppeId);
  fd.append('kuenstler_id', kid);
  fd.append('action',       'add');
  try {
    const r = await fetch('/admin/veranstaltungen/gruppe_members_ajax.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) {
      gkAdded++;
      const row = btn.closest('.tn-row');
      if (row) { row.style.opacity = '.4'; row.style.pointerEvents = 'none'; }
      btn.textContent = 'Hinzugefügt';
    } else {
      btn.disabled = false;
    }
  } catch { btn.disabled = false; }
}

// ─── Programmpunkte Dialog ─────────────────────────────────────

const progDialog  = document.getElementById('prog-dialog');
const progTage    = {{ tage|json_encode|raw }}.map(t => t.datum);
const WD = ['Sonntag','Montag','Dienstag','Mittwoch','Donnerstag','Freitag','Samstag'];

function fmtDatum(d) { const [y,m,t] = d.split('-'); return `${t}.${m}.${y}`; }
function fmtWd(d)    { return WD[new Date(d + 'T12:00:00').getDay()] ?? ''; }

let progAllParticipants = [];
let progSelectedTns     = new Map(); // id(int) → name

function progRenderChips() {
  const el = document.getElementById('prog-tn-chips');
  el.innerHTML = [...progSelectedTns.entries()].map(([id, name]) =>
    `<span style="display:inline-flex;align-items:center;gap:.375rem;padding:.25rem .625rem;background:var(--bg-muted,#f1f5f9);border:1px solid var(--border);border-radius:20px;font-size:.8125rem">
      ${escHtml(name)}
      <button type="button" class="prog-chip-rm" data-id="${id}"
              style="background:none;border:none;cursor:pointer;color:var(--text-muted);line-height:1;padding:0" title="Entfernen">✕</button>
    </span>`
  ).join('');
}

function progRenderDropdown() {
  const term = document.getElementById('prog-tn-search').value.toLowerCase();
  const dd   = document.getElementById('prog-tn-dropdown');
  const pool = progAllParticipants.filter(p => !progSelectedTns.has(parseInt(p.id)));
  const hits = term ? pool.filter(p => p.name.toLowerCase().includes(term)) : pool;
  if (!hits.length) {
    dd.innerHTML = `<div style="padding:.5rem .75rem;color:var(--text-muted);font-size:.875rem">${term ? 'Keine Ergebnisse.' : 'Alle bereits ausgewählt.'}</div>`;
  } else {
    dd.innerHTML = hits.map(p =>
      `<button type="button" class="prog-tn-opt" data-id="${parseInt(p.id)}"
        style="display:block;width:100%;text-align:left;padding:.5rem .75rem;border:none;background:none;cursor:pointer;font-size:.875rem;border-bottom:1px solid var(--border)">
        ${escHtml(p.name)}
      </button>`
    ).join('');
  }
  dd.style.display = '';
}

document.addEventListener('click', e => {
  if (!e.target.closest('#prog-tn-section')) {
    const dd = document.getElementById('prog-tn-dropdown');
    if (dd) dd.style.display = 'none';
  }
});

function switchProgLang(btn, lang) {
  btn.closest('.lang-tabs').querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('prog-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('prog-panel-en').style.display = lang === 'en' ? '' : 'none';
}

function buildDatumOptions(selected) {
  return progTage.map(d =>
    `<option value="${d}"${d === selected ? ' selected' : ''}>${fmtWd(d)}, ${fmtDatum(d)}</option>`
  ).join('');
}

async function openProgDialog(pid, defaultDatum) {
  window._tt.ensureProgEditors();
  document.getElementById('prog-dialog-error').style.display = 'none';
  document.getElementById('prog-id').value     = pid || '';
  document.getElementById('prog-datum').innerHTML = buildDatumOptions(defaultDatum || '');
  document.getElementById('prog-uhrzeit').value   = '';
  document.getElementById('prog-ort-name').value     = '';
  document.getElementById('prog-ort-name-en').value  = '';
  window._tt.progTitel.commands.clearContent();
  window._tt.progBeschr.commands.clearContent();
  window._tt.progTitelEN.commands.clearContent();
  window._tt.progBeschrEN.commands.clearContent();
  progSelectedTns = new Map();
  progRenderChips();
  document.getElementById('prog-tn-search').value = '';
  document.getElementById('prog-tn-dropdown').style.display = 'none';
  document.getElementById('prog-tn-section').style.display = 'none';
  document.getElementById('prog-dialog-title').textContent    = pid ? 'Programmpunkt bearbeiten' : 'Programmpunkt hinzufügen';
  document.getElementById('prog-dialog-submit').textContent   = pid ? 'Speichern' : 'Hinzufügen';
  progDialog.showModal();

  try {
    const url = `/admin/veranstaltungen/programm_ajax.php?veranstaltung_id=${partVid}${pid ? '&id=' + pid : ''}`;
    const r = await fetch(url);
    const d = await r.json();
    if (!d.ok) return;

    if (d.entry) {
      document.getElementById('prog-datum').innerHTML    = buildDatumOptions(d.entry.datum);
      document.getElementById('prog-uhrzeit').value      = (d.entry.uhrzeit || '').slice(0, 5);
      document.getElementById('prog-ort-name').value     = d.entry.ort_name    || '';
      document.getElementById('prog-ort-name-en').value  = d.entry.ort_name_en || '';
      if (d.entry.titel)           window._tt.progTitel.commands.setContent(d.entry.titel);
      if (d.entry.titel_en)        window._tt.progTitelEN.commands.setContent(d.entry.titel_en);
      if (d.entry.beschreibung)    window._tt.progBeschr.commands.setContent(d.entry.beschreibung);
      if (d.entry.beschreibung_en) window._tt.progBeschrEN.commands.setContent(d.entry.beschreibung_en);
    }

    if (d.participants.length) {
      progAllParticipants = d.participants;
      const assigned = d.assigned.map(Number);
      progSelectedTns = new Map(
        d.participants.filter(p => assigned.includes(parseInt(p.id))).map(p => [parseInt(p.id), p.name])
      );
      progRenderChips();
      document.getElementById('prog-tn-section').style.display = '';
    } else {
      progAllParticipants = [];
      document.getElementById('prog-tn-section').style.display = 'none';
    }
  } catch {}
}

document.getElementById('prog-dialog-close').addEventListener('click',  () => progDialog.close());
document.getElementById('prog-dialog-cancel').addEventListener('click', () => progDialog.close());
progDialog.addEventListener('click', e => { if (e.target === progDialog) progDialog.close(); });

document.getElementById('prog-tn-chips').addEventListener('click', e => {
  const btn = e.target.closest('.prog-chip-rm');
  if (!btn) return;
  progSelectedTns.delete(parseInt(btn.dataset.id));
  progRenderChips();
  if (document.getElementById('prog-tn-dropdown').style.display !== 'none') progRenderDropdown();
});

document.getElementById('prog-tn-dropdown').addEventListener('click', e => {
  const btn = e.target.closest('.prog-tn-opt');
  if (!btn) return;
  const id = parseInt(btn.dataset.id);
  const p  = progAllParticipants.find(p => parseInt(p.id) === id);
  if (p) progSelectedTns.set(id, p.name);
  progRenderChips();
  document.getElementById('prog-tn-search').value = '';
  document.getElementById('prog-tn-dropdown').style.display = 'none';
});

document.getElementById('prog-tn-search').addEventListener('focus', () => progRenderDropdown());
document.getElementById('prog-tn-search').addEventListener('input', () => progRenderDropdown());

document.getElementById('prog-dialog-submit').addEventListener('click', async () => {
  const errEl = document.getElementById('prog-dialog-error');
  errEl.style.display = 'none';

  const tt = window._tt;
  const fd = new FormData();
  fd.append('veranstaltung_id', partVid);
  fd.append('id',          document.getElementById('prog-id').value || '');
  fd.append('datum',       document.getElementById('prog-datum').value);
  fd.append('uhrzeit',     document.getElementById('prog-uhrzeit').value);
  fd.append('titel',          tt.edHTML(tt.progTitel));
  fd.append('titel_en',       tt.edHTML(tt.progTitelEN));
  fd.append('beschreibung',   tt.edHTML(tt.progBeschr));
  fd.append('beschreibung_en', tt.edHTML(tt.progBeschrEN));
  fd.append('ort_name',    document.getElementById('prog-ort-name').value);
  fd.append('ort_name_en', document.getElementById('prog-ort-name-en').value);
  progSelectedTns.forEach((name, id) => fd.append('teilnehmer[]', id));

  const btn = document.getElementById('prog-dialog-submit');
  const origText = btn.textContent;
  btn.disabled = true; btn.textContent = 'Speichern …';
  try {
    const r = await fetch('/admin/veranstaltungen/programm_ajax.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) { progDialog.close(); refreshProgTile(d.datum); }
    else {
      const msg = d.errors ? d.errors.join(' ') : (d.error || 'Fehler.');
      errEl.textContent = msg; errEl.style.display = '';
    }
  } catch { errEl.textContent = 'Fehler beim Speichern.'; errEl.style.display = ''; }
  finally { btn.disabled = false; btn.textContent = origText; }
});

async function deleteProgEntry(pid, datum) {
  if (!confirm('Programmpunkt wirklich löschen?')) return;
  const fd = new FormData();
  fd.append('veranstaltung_id', partVid);
  fd.append('action', 'delete');
  fd.append('id', pid);
  try {
    const r = await fetch('/admin/veranstaltungen/programm_ajax.php', { method: 'POST', body: fd });
    const d = await r.json();
    if (d.ok) refreshProgTile(datum);
  } catch {}
}

async function refreshProgTile(datum) {
  try {
    const r = await fetch(`/admin/veranstaltungen/programm_ajax.php?veranstaltung_id=${partVid}&action=list&datum=${datum}`);
    const d = await r.json();
    if (!d.ok) return;
    const el = document.querySelector(`.tag-tile-prog[data-datum="${datum}"]`);
    if (!el) return;
    el.innerHTML = d.entries.map(e => `
      <div class="tag-tile-prog-item">
        <div class="tag-tile-prog-time">${escHtml((e.uhrzeit || '').slice(0, 5))}</div>
        <div class="tag-tile-prog-body">
          <div class="tag-tile-prog-title">${escHtml(stripTags(e.titel || ''))}</div>
          ${e.ort_name ? `<div class="tag-tile-prog-loc">${escHtml(e.ort_name)}</div>` : ''}
        </div>
        <div class="tag-tile-prog-actions">
          <button type="button" class="btn btn-ghost btn-sm"
                  onclick="openProgDialog(${e.id},'${datum}')">Bearbeiten</button>
          <button type="button" class="btn btn-ghost btn-sm" style="color:var(--danger)"
                  onclick="deleteProgEntry(${e.id},'${datum}')">Löschen</button>
        </div>
      </div>`).join('')
      + (d.entries.length === 0 ? '<div class="tag-tile-empty">Noch keine Programmpunkte für diesen Tag.</div>' : '')
      + `<a href="#" class="tag-tile-add" onclick="openProgDialog(null,'${datum}'); return false;">
           <i class="fa-solid fa-plus"></i> Programmpunkt hinzufügen
         </a>`;
  } catch {}
}

function stripTags(html) {
  const el = document.createElement('div');
  el.innerHTML = html;
  return el.textContent || el.innerText || '';
}
</script>
{% endif %}
{% endblock %}
