<script>
const dateCfg = {
  locale: 'de', dateFormat: 'Y-m-d', altInput: true, altFormat: 'd.m.Y', allowInput: true,
};
const timeCfg = {
  locale: 'de', enableTime: true, noCalendar: true, time_24hr: true, dateFormat: 'H:i', allowInput: true,
};

function initFlatpickrRow(tile) {
  tile.querySelectorAll('.fp-date').forEach(el => flatpickr(el, dateCfg));
  tile.querySelectorAll('.fp-time').forEach(el => flatpickr(el, timeCfg));
}
document.querySelectorAll('#tage-container .tag-tile').forEach(initFlatpickrRow);

const container = document.getElementById('tage-container');

function syncRemoveButtons() {
  const tiles = container.querySelectorAll('.tag-tile');
  tiles.forEach(t => { t.querySelector('.remove-tag').disabled = tiles.length === 1; });
}

const REMOVE_ICON = `<i class="fa-solid fa-trash" aria-hidden="true"></i>`;

document.getElementById('add-tag').addEventListener('click', () => {
  const tile = document.createElement('div');
  tile.className = 'tag-tile';
  tile.innerHTML = `
    <div class="tag-tile-fields no-prog">
      <div>
        <label class="tag-field-label">Datum <span class="req">*</span></label>
        <input class="fp-date" type="text" name="tag_datum[]">
      </div>
      <div>
        <label class="tag-field-label">Von <span class="req">*</span></label>
        <input class="fp-time" type="text" name="tag_startzeit[]">
      </div>
      <div>
        <label class="tag-field-label">Bis <span class="req">*</span></label>
        <input class="fp-time" type="text" name="tag_endzeit[]">
      </div>
      <button type="button" class="btn btn-ghost btn-icon remove-tag" title="Tag entfernen">${REMOVE_ICON}</button>
    </div>`;
  container.appendChild(tile);
  initFlatpickrRow(tile);
  tile.querySelector('.fp-date').focus();
  syncRemoveButtons();
});

container.addEventListener('click', e => {
  if (e.target.closest('.remove-tag')) {
    e.target.closest('.tag-tile').remove();
    syncRemoveButtons();
  }
});

syncRemoveButtons();

function syncQuillContent() {
  const tt = window._tt;
  document.getElementById('kurzbeschreibung-input').value    = tt.edHTML(tt.edKurz);
  document.getElementById('kurzbeschreibung-en-input').value = tt.edHTML(tt.edKurzEN);
  document.getElementById('beschreibung-input').value        = tt.edHTML(tt.edMain);
  document.getElementById('beschreibung-en-input').value     = tt.edHTML(tt.edMainEN);
}

function switchFormLang(btn, lang) {
  btn.closest('.lang-tabs').querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('form-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('form-panel-en').style.display = lang === 'en' ? '' : 'none';
}

function showFormFlash(type, msg) {
  const el = document.getElementById('form-flash');
  el.className = 'alert alert-' + type;
  el.textContent = msg;
  el.hidden = false;
  clearTimeout(el._t);
  if (type === 'success') el._t = setTimeout(() => { el.hidden = true; }, 3500);
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

document.getElementById('main-form').addEventListener('submit', async (e) => {
  syncQuillContent();
  {% if not is_edit %}
  return;
  {% endif %}
  e.preventDefault();
  const btn = document.getElementById('form-submit-btn');
  const origText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Speichern …';
  const fd = new FormData(e.target);
  fd.append('_ajax', '1');
  try {
    const r    = await fetch('', { method: 'POST', body: fd });
    const data = await r.json();
    if (data.ok) {
      showFormFlash('success', data.msg);
    } else {
      showFormFlash('error', data.errors.join(' '));
    }
  } catch {
    showFormFlash('error', 'Fehler beim Speichern.');
  } finally {
    btn.disabled = false;
    btn.textContent = origText;
  }
});

</script>

