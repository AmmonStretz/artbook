function switchFormLang(btn, lang) {
  btn.closest('.lang-tabs').querySelectorAll('.lang-tab').forEach(b => b.classList.remove('active'));
  btn.classList.add('active');
  document.getElementById('form-panel-de').style.display = lang === 'de' ? '' : 'none';
  document.getElementById('form-panel-en').style.display = lang === 'en' ? '' : 'none';
}

function showFormFlash(type, msg) {
  const el = document.getElementById('form-flash');
  el.className = 'alert alert-' + type;
  el.textContent = msg;
  el.hidden = false;
  clearTimeout(el._t);
  if (type === 'success') el._t = setTimeout(() => { el.hidden = true; }, 3500);
  el.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
}

document.getElementById('main-form').addEventListener('submit', async (e) => {
  syncQuillContent();
  {% if not is_edit %}
  return;
  {% endif %}
  e.preventDefault();
  const btn = document.getElementById('form-submit-btn');
  const origText = btn.textContent;
  btn.disabled = true;
  btn.textContent = 'Speichern …';
  const fd = new FormData(e.target);
  fd.append('_ajax', '1');
  try {
    const r    = await fetch('', { method: 'POST', body: fd });
    const data = await r.json();
    if (data.ok) {
      showFormFlash('success', data.msg);
    } else {
      showFormFlash('error', data.errors.join(' '));
    }
  } catch {
    showFormFlash('error', 'Fehler beim Speichern.');
  } finally {
    btn.disabled = false;
    btn.textContent = origText;
  }
});

delete L.Icon.Default.prototype._getIconUrl;
L.Icon.Default.mergeOptions({
  iconUrl:       'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon.png',
  iconRetinaUrl: 'https://unpkg.com/leaflet@1.9.4/dist/images/marker-icon-2x.png',
  shadowUrl:     'https://unpkg.com/leaflet@1.9.4/dist/images/marker-shadow.png',
});

const initLat = parseFloat(document.getElementById('lat').value);
const initLng = parseFloat(document.getElementById('lng').value);
const hasCoords = !isNaN(initLat) && !isNaN(initLng);

const map = L.map('map').setView(
  hasCoords ? [initLat, initLng] : [51.1657, 10.4515],
  hasCoords ? 14 : 6
);

L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
  attribution: '© <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
  maxZoom: 19
}).addTo(map);

let marker = hasCoords ? L.marker([initLat, initLng]).addTo(map) : null;

function placeMarker(lat, lng) {
  const pos = [+lat.toFixed(6), +lng.toFixed(6)];
  marker ? marker.setLatLng(pos) : (marker = L.marker(pos).addTo(map));
  document.getElementById('lat').value = pos[0];
  document.getElementById('lng').value = pos[1];
}

map.on('click', e => placeMarker(e.latlng.lat, e.latlng.lng));

function syncMapFromInputs() {
  const lat = parseFloat(document.getElementById('lat').value);
  const lng = parseFloat(document.getElementById('lng').value);
  if (!isNaN(lat) && !isNaN(lng) && lat >= -90 && lat <= 90 && lng >= -180 && lng <= 180) {
    placeMarker(lat, lng);
    map.setView([lat, lng], map.getZoom() < 10 ? 14 : map.getZoom());
  }
}

document.getElementById('lat').addEventListener('change', syncMapFromInputs);
document.getElementById('lng').addEventListener('change', syncMapFromInputs);
</script>

