{% extends 'base.twig' %}

{% block content %}
  <section class="detail-header" style="padding:2rem 0 1.75rem">
    <div class="container">
      <h1 class="detail-title">{{ t('artists.title') }}</h1>
    </div>
  </section>

  <section class="section" style="padding-top:2rem">
    <div class="container">
      <form method="get" class="pub-search">
        <input type="search" name="q" value="{{ q }}"
               class="pub-search-input" placeholder="{{ t('artists.search_placeholder') }}" autocomplete="off">
        <select name="typ" class="pub-filter-select" onchange="this.form.submit()">
          <option value="" {{ typ == '' ? 'selected' : '' }}>{{ t('artists.filter_all') }}</option>
          <option value="kuenstler" {{ typ == 'kuenstler' ? 'selected' : '' }}>{{ t('artists.filter_artists') }}</option>
          <option value="gruppe" {{ typ == 'gruppe' ? 'selected' : '' }}>{{ t('artists.filter_groups') }}</option>
        </select>
        {% if veranstaltungen %}
          <select name="veranstaltung" class="pub-filter-select" onchange="this.form.submit()">
            <option value="">{{ t('artists.filter_events') }}</option>
            {% for va in veranstaltungen %}
              {% set va_name = (lang == 'en' and va.name_en) ? va.name_en : va.name %}
              <option value="{{ va.id }}" {{ fvid == va.id ? 'selected' : '' }}>{{ va_name }}</option>
            {% endfor %}
          </select>
        {% endif %}
        <button type="submit" class="pub-btn pub-btn-ghost">{{ t('artists.search_btn') }}</button>
        {% if q or typ or fvid %}
          <a href="{{ langUrl('/kuenstler.php') }}" class="pub-btn pub-btn-ghost">{{ t('artists.reset') }}</a>
        {% endif %}
      </form>

      {% if total == 0 %}
        <p class="text-muted">{{ t('artists.no_results') }}</p>
      {% else %}
        <p class="results-info">{{ total }} {{ t('artists.entries') }}</p>
        <div class="participant-grid">
          {% for r in rows %}
            {% set thumb = thumbUrl(r.first_image) %}
            {% set type_label = typeLabel(r.typ, r.gruppe_typ) %}
            <a href="{{ langUrl('/teilnehmer.php') }}?id={{ r.id }}" class="participant-card">
              {% if thumb %}
                <img src="{{ thumb }}" alt="{{ r.name }}" class="participant-thumb" loading="lazy">
              {% else %}
                <div class="participant-thumb-placeholder">
                  <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <circle cx="8.5" cy="8.5" r="1.5"/>
                    <polyline points="21 15 16 10 5 21"/>
                  </svg>
                </div>
              {% endif %}
              <div class="participant-info">
                <div class="participant-name">{{ r.name }}</div>
                <div class="participant-type">{{ type_label }}</div>
              </div>
            </a>
          {% endfor %}
        </div>

        {% include 'partials/pagination.twig' with {
          page: page, pages: pages,
          pagination_base: buildQuery({q: q, typ: typ, veranstaltung: fvid})
        } %}
      {% endif %}
    </div>
  </section>
{% endblock %}
